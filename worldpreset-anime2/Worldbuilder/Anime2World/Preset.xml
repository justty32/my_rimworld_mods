      <li>Bandit</li>
      <li>Guild</li>
      <li>LucifersCartel</li>
      <li>Ancients</li>
    </keys>
    <values>
      <li><factionDefNames><li>Milira_Faction</li></factionDefNames></li>
      <li><factionDefNames><li>Milira_AngelismChurch</li></factionDefNames></li>
      <li><factionDefNames><li>Kiiro_Faction</li></factionDefNames></li>
      <li><factionDefNames><li>AxolotlWanderingDynasty</li></factionDefNames></li>
      <li><factionDefNames><li>USAC_Faction</li></factionDefNames></li>
      <li><factionDefNames><li>DMS_Army</li><li>DMS_AncientCorps</li></factionDefNames></li>
      <li><factionDefNames><li>OA_RK_Faction</li></factionDefNames></li>
      <li><factionDefNames><li>RKU_Faction</li></factionDefNames></li>
      <li><factionDefNames><li>Rakinia_Warlord</li></factionDefNames></li>
      <li><factionDefNames><li>ZHP_Faction</li></factionDefNames></li>
      <li><factionDefNames><li>Rakinia</li><li>RKK_KnightOrders</li></factionDefNames></li>
      <li><factionDefNames><li>Rakinia_RockRatkin</li></factionDefNames></li>
      <li><factionDefNames><li>Rakinia_SnowRatkin</li></factionDefNames></li>
      <li><factionDefNames><li>Rakinia_TravelRatkin</li></factionDefNames></li>
      <li><factionDefNames><li>OutlanderCivil</li></factionDefNames></li>
      <li><factionDefNames><li>OutlanderRough</li></factionDefNames></li>
      <li><factionDefNames><li>TradersGuild</li></factionDefNames></li>
      <li><factionDefNames><li>TribeCivil</li></factionDefNames></li>
      <li><factionDefNames><li>Empire</li></factionDefNames></li>
      <li><factionDefNames><li>Pirate</li></factionDefNames></li>
      <li><factionDefNames><li>PirateYttakin</li></factionDefNames></li>
      <li><factionDefNames><li>CannibalPirate</li></factionDefNames></li>
      <li><factionDefNames><li>TribeCannibal</li></factionDefNames></li>
      <li><factionDefNames><li>SettlerSavage</li></factionDefNames></li>
      <li><factionDefNames><li>GuildFaction_AdventurersGuild</li></factionDefNames></li>
      <li><factionDefNames><li>PC_Faction_LucifersCartel</li></factionDefNames></li>
      <li><factionDefNames><li>Ancients</li><li>AncientsHostile</li></factionDefNames></li>
    </values>
  </savedIdeoFactionMapping>

