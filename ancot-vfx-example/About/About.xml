<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>Ancot VFX Example (pas)</name>
  <author>justty32</author>
  <packageId>pas.ancot.vfxexample</packageId>
  <supportedVersions>
    <li>1.6</li>
  </supportedVersions>
  <description>Minimal pure-XML showcase of Ancot Library's VFX hooks: projectile trail + impact effecter, melee-hit slash effecter, and a hediff-maintained smoke aura ability. Test items spawn via dev mode.</description>
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=2009463077</steamWorkshopUrl>
    </li>
    <li>
      <packageId>Ancot.AncotLibrary</packageId>
      <displayName>Ancot Library</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=2988801276</steamWorkshopUrl>
    </li>
  </modDependencies>
  <loadAfter>
    <li>brrainz.harmony</li>
    <li>Ancot.AncotLibrary</li>
  </loadAfter>
</ModMetaData>
