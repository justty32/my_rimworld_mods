<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    ★赤爪傭兵團（T2 具名客戶·團長鋼鐵之誓）忠誠獎勵道具《傭兵助戰契約》——一紙契約，只能用一次、用過即毀。
    仿《鼠族王國徵召令狀》(RatkinQL_KingdomTally) 而作：交付軍火、做到讓鋼鐵之誓夠信得過後，由對話分支發放（Line_ForgeRedClawBand）。
    動用（捏碎契約）後召鼠族傭兵援軍馳援：C# CompUseEffect_RatkinAid → RaidFriendly + Rakinia + ImmediateAttackFriendly + EdgeWalkIn。
    一次即毀（CompProperties_UseEffectDestroySelf）。points 800（同令狀量級）。貼圖借原版捲軸/文件（Schematic），主題一致＝一紙契約。
    label/description 先內嵌英文；zh DefInjected 可省（同 KingdomTally）。
  -->
  <ThingDef ParentName="ResourceBase">
    <defName>RatkinQL_MercenaryContract</defName>
    <label>red claw aid contract</label>
    <description>A blood-sealed contract from the Red Claw Mercenary Band, pressed into your hand by Captain Steelvow herself. It is a promise kept but once: crush it, and Red Claw's blades come running to your aid. Spent the moment it is called upon.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/Book/Schematic/Schematic</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>1</stackLimit>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <statBases>
      <MarketValue>250</MarketValue>
      <Mass>0.2</Mass>
      <MaxHitPoints>40</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>2.0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Items</li>
    </thingCategories>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseArtifact</useJob>
        <useLabel>Invoke {0_label}</useLabel>
        <showUseGizmo>true</showUseGizmo>
        <useDuration>120</useDuration>
      </li>
      <li Class="RatkinQuestlines.CompProperties_RatkinAid">
        <points>800</points>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf" />
    </comps>
  </ThingDef>

</Defs>
