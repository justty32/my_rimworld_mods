<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    ★鐵匠屋 T2 旗艦 — 赤爪傭兵團·團長鋼鐵之誓（軍火定製委託）。
    T2＝品質門檻定製：她要一批「良好以上」的軍械，把傭兵團武裝起來（彈性價值需求，不指定 defName）。
    gate＝有鐵匠檯(CanForge) ＋ 鋼鐵之誓可上門(Forge_RedClawBand_Available：帳本已內含 T2 名聲門檻且未 blocked)。
    接受即空投 T2 科技藍圖（沿用城鎮層藍圖，gateBool 保證每層一次）；延遲 12 天到訪；交貨走 C 挑選視窗＋分級後果。
    善惡＝中性/灰色傭兵（§6.7）：band1 達標只記傭兵名聲、band2 超額把傭兵武裝到牙齒→Ev_Cruelty（惡＋）。
    忠誠獎勵＝助戰契約（傭兵版召兵 writ），由對話分支發（見 Line）。稱呼用 T2 層「鐵匠鋪」。
  -->
  <QuestScriptDef>
    <defName>RatkinQL_ForgeRedClawBand</defName>
    <rootSelectionWeight>1</rootSelectionWeight>
    <rootMinPoints>0</rootMinPoints>
    <rootMinProgressScore>0</rootMinProgressScore>
    <expireDaysRange>7~15</expireDaysRange>
    <canGiveRoyalFavor>false</canGiveRoyalFavor>

    <questNameRules>
      <rulesStrings>
        <li>questName->赤爪傭兵團的軍火定製</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->赤爪傭兵團團長「鋼鐵之誓」拍馬找上門：傭兵團要備一批良好品質以上的傢伙事兒，款式不拘、但得夠份量、夠靠得住。接下委託後給你約十二天備料開爐，屆時她親自帶弟兄們上門提貨。（若你尚未掌握這一層的鍛造，接下時她會先扔給你一卷圖譜。）</li>
      </rulesStrings>
    </questDescriptionRules>

    <root Class="QuestNode_Sequence">
      <nodes>

        <li Class="RatkinQuestlines.QuestNode_RequireGlobalBool">
          <key>RatkinQL_CanForge</key>
        </li>
        <li Class="RatkinQuestlines.QuestNode_RequireGlobalBool">
          <key>RatkinQL_Forge_RedClawBand_Available</key>
        </li>

        <li Class="QuestNode_GetMap">
          <canBeSpace>false</canBeSpace>
        </li>

        <!-- T2 層首個委託：接受即空投 T2 科技藍圖（沿用城鎮層藍圖與 letter，每層一次） -->
        <li Class="RatkinQuestlines.QuestNode_DropTechBlueprintOnce">
          <blueprint>RatkinQL_TechBlueprint_ForgeTierTwo</blueprint>
          <gateBool>RatkinQL_Forge_T2TechGifted</gateBool>
          <letterLabel>RatkinQL_Forge_T2Tech_Label</letterLabel>
          <letterText>RatkinQL_Forge_T2Tech_Text</letterText>
        </li>

        <!-- 提貨延遲：約 12 天 -->
        <li Class="QuestNode_Delay">
          <delayTicks>720000</delayTicks>
          <outSignalComplete>EnvoyArrive</outSignalComplete>
        </li>

        <li Class="RatkinQuestlines.QuestNode_SpawnRatkinEnvoy">
          <inSignal>EnvoyArrive</inSignal>
          <dialogManager>RatkinQL_ForgeRedClawBandManager</dialogManager>
          <factionDef>Rakinia</factionDef>
          <letterLabel>RatkinQL_Forge_RedClaw_ArriveLabel</letterLabel>
          <letterText>RatkinQL_Forge_RedClaw_ArriveText</letterText>
        </li>

        <li Class="QuestNode_Delay">
          <inSignalEnable>EnvoyArrive</inSignalEnable>
          <delayTicks>900000</delayTicks>
          <outSignalComplete>EnvoyVisitDone</outSignalComplete>
        </li>
        <li Class="QuestNode_End">
          <inSignal>EnvoyVisitDone</inSignal>
          <outcome>Success</outcome>
        </li>

      </nodes>
    </root>
  </QuestScriptDef>

</Defs>
