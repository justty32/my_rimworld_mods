<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 《走唱的伶人》— F1：一名鼠族賣藝人，投幾個錢就為你唱一段。溫暖、有文化味。 -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_MinstrelTree</defName>
    <title>RatkinQL_MinstrelTree_Title</title>
    <dialogReportKey>RatkinQL_MinstrelTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>
      <li><key>0</key><value>
        <text>RatkinQL_Minstrel_Greeting</text>
        <index>0</index><subNodeIndexs><li>1</li><li>2</li></subNodeIndexs>
        <options>
          <li>
            <text>RatkinQL_Minstrel_OptSong</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <requiredThings><li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>5~5</count></li></requiredThings>
            <results><li><resultName>Sang</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction"><targetsText><li>Interviewee</li></targetsText><isIncrease>true</isIncrease><value>1</value><sendLetter>false</sendLetter></li>
                <li Class="QuestEditor_Library.CQFAction_Message"><message>RatkinQL_Minstrel_MsgSong</message><type>PositiveEvent</type></li>
              </actions>
              <nextIndex>2</nextIndex></li></results>
          </li>
          <li><text>RatkinQL_Minstrel_OptTale</text><results><li><resultName>GoTale</resultName><nextIndex>1</nextIndex></li></results></li>
          <li><text>RatkinQL_Minstrel_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li>
        </options>
      </value></li>
      <li><key>1</key><value>
        <text>RatkinQL_Minstrel_Tale1</text>
        <extraText><li>RatkinQL_Minstrel_Tale2</li><li>RatkinQL_Minstrel_Tale3</li></extraText>
        <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Minstrel_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>
      <li><key>2</key><value>
        <text>RatkinQL_Minstrel_Farewell</text>
        <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Minstrel_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li></options>
      </value></li>
    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_MinstrelManager</defName>
    <tags><li>RatkinQL_Minstrel</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_MinstrelTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>
</Defs>
