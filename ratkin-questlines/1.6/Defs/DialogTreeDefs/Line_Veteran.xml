<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 《醉話的老兵》— F1：一名微醺的鼠族退伍老兵，想找人喝一杯、講講當年。詼諧中帶滄桑。 -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_VeteranTree</defName>
    <title>RatkinQL_VeteranTree_Title</title>
    <dialogReportKey>RatkinQL_VeteranTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>
      <li><key>0</key><value>
        <text>RatkinQL_Veteran_Greeting</text>
        <index>0</index><subNodeIndexs><li>1</li><li>2</li></subNodeIndexs>
        <options>
          <li>
            <text>RatkinQL_Veteran_OptDrink</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <requiredThings><li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>10~10</count></li></requiredThings>
            <results><li><resultName>Drank</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction"><targetsText><li>Interviewee</li></targetsText><isIncrease>true</isIncrease><value>1</value><sendLetter>false</sendLetter></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Rep_Kind</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="QuestEditor_Library.CQFAction_Message"><message>RatkinQL_Veteran_MsgDrink</message><type>PositiveEvent</type></li>
              </actions>
              <nextIndex>2</nextIndex></li></results>
          </li>
          <li><text>RatkinQL_Veteran_OptStory</text><results><li><resultName>GoStory</resultName><nextIndex>1</nextIndex></li></results></li>
          <li><text>RatkinQL_Veteran_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li>
        </options>
      </value></li>
      <li><key>1</key><value>
        <text>RatkinQL_Veteran_War1</text>
        <extraText><li>RatkinQL_Veteran_War2</li><li>RatkinQL_Veteran_War3</li></extraText>
        <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Veteran_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>
      <li><key>2</key><value>
        <text>RatkinQL_Veteran_Farewell</text>
        <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Veteran_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li></options>
      </value></li>
    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_VeteranManager</defName>
    <tags><li>RatkinQL_Veteran</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_VeteranTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>
</Defs>
