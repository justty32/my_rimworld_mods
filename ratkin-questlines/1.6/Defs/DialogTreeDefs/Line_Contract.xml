<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    《鼠族供貨約》觸發對話 — F2 proof-slice 的入口。
    接約選項：交首批存糧（requiredThings Pemmican 30）→ CQFAction_Quest 觸發 RatkinQL_SupplyContract
    ＋提升鼠族好感 ＋記「供應商」身份傾向旗標（供日後 F7 身份系統讀）。
    removeDialogAfterSelect＝一位客商一份約，杜絕重複套現。
  -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_ContractTree</defName>
    <title>RatkinQL_ContractTree_Title</title>
    <dialogReportKey>RatkinQL_ContractTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>
      <li><key>0</key><value>
        <text>RatkinQL_Contract_Greeting</text>
        <index>0</index><subNodeIndexs><li>1</li><li>2</li></subNodeIndexs>
        <options>
          <li>
            <text>RatkinQL_Contract_OptAccept</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <requiredThings>
              <li Class="QuestEditor_Library.CQFThingDefCount"><thing>Pemmican</thing><count>30~30</count></li>
            </requiredThings>
            <results><li>
              <resultName>Accepted</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                  <targetsText><li>Interviewee</li></targetsText>
                  <isIncrease>true</isIncrease><value>2</value><sendLetter>false</sendLetter>
                </li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool">
                  <keyOfBool>RatkinQL_Ident_Supplier</keyOfBool><valueOfBool>true</valueOfBool>
                </li>
                <li Class="QuestEditor_Library.CQFAction_Quest">
                  <quest>RatkinQL_SupplyContract</quest>
                </li>
              </actions>
              <nextIndex>2</nextIndex>
            </li></results>
          </li>
          <li><text>RatkinQL_Contract_OptTerms</text><results><li><resultName>GoTerms</resultName><nextIndex>1</nextIndex></li></results></li>
          <li><text>RatkinQL_Contract_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li>
        </options>
      </value></li>
      <li><key>1</key><value>
        <text>RatkinQL_Contract_Terms1</text>
        <extraText><li>RatkinQL_Contract_Terms2</li><li>RatkinQL_Contract_Terms3</li></extraText>
        <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Contract_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>
      <li><key>2</key><value>
        <text>RatkinQL_Contract_Farewell</text>
        <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Contract_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li></options>
      </value></li>
    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_ContractManager</defName>
    <tags><li>RatkinQL_Contract</li></tags>
    <genrationConditions>
      <!-- 限鼠族派系 -->
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
      <!-- F7：僅在殖民地「已成熟」時才提供供貨約（§2 成熟門檻）。旗標由 C# 側寫器 MapComponent_RatkinColonyProfiler 寫入。 -->
      <li Class="QuestEditor_Library.DialogCondition_Bool">
        <failReason>RatkinQL_NotRatkin</failReason>
        <boolName>RatkinQL_State_Established</boolName>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_ContractTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
