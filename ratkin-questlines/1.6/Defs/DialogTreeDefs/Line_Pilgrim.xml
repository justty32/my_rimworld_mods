<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    《朝聖的香客》— F1：一名鼠族香客在前往聖地的途中，向你討一頓飯食與歇腳。
    玩家可供餐留宿（給 3 硬餅乾→好感）／問其朝聖（信仰世界感）／請他為聚居地祝禱（訊息祝福＋小好感）。
    文案 Keyed 見 RatkinQL_Pilgrim.xml。
  -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_PilgrimTree</defName>
    <title>RatkinQL_PilgrimTree_Title</title>
    <dialogReportKey>RatkinQL_PilgrimTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>

      <li>
        <key>0</key>
        <value>
          <text>RatkinQL_Pilgrim_Greeting</text>
          <index>0</index>
          <subNodeIndexs><li>1</li><li>2</li></subNodeIndexs>
          <options>

            <li>
              <text>RatkinQL_Pilgrim_OptMeal</text>
              <removeDialogAfterSelect>true</removeDialogAfterSelect>
              <requiredThings>
                <li Class="QuestEditor_Library.CQFThingDefCount"><thing>RK_Food_Hardtack</thing><count>3~3</count></li>
              </requiredThings>
              <results>
                <li>
                  <resultName>GaveMeal</resultName>
                  <actions>
                    <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                      <targetsText><li>Interviewee</li></targetsText>
                      <isIncrease>true</isIncrease><value>2</value><sendLetter>true</sendLetter>
                    </li>
                    <li Class="QuestEditor_Library.CQFAction_SetGlobalBool">
                      <keyOfBool>RatkinQL_Rep_Hospitable</keyOfBool><valueOfBool>true</valueOfBool>
                    </li>
                    <li Class="QuestEditor_Library.CQFAction_Message">
                      <message>RatkinQL_Pilgrim_MsgMeal</message><type>PositiveEvent</type>
                    </li>
                  </actions>
                  <nextIndex>2</nextIndex>
                </li>
              </results>
            </li>

            <li>
              <text>RatkinQL_Pilgrim_OptStory</text>
              <results><li><resultName>GoStory</resultName><nextIndex>1</nextIndex></li></results>
            </li>

            <li>
              <text>RatkinQL_Pilgrim_OptBlessing</text>
              <removeDialogAfterSelect>true</removeDialogAfterSelect>
              <results>
                <li>
                  <resultName>Blessing</resultName>
                  <actions>
                    <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                      <targetsText><li>Interviewee</li></targetsText>
                      <isIncrease>true</isIncrease><value>1</value><sendLetter>false</sendLetter>
                    </li>
                    <li Class="QuestEditor_Library.CQFAction_Message">
                      <message>RatkinQL_Pilgrim_MsgBlessing</message><type>PositiveEvent</type>
                    </li>
                  </actions>
                  <nextIndex>2</nextIndex>
                </li>
              </results>
            </li>

            <li>
              <text>RatkinQL_Pilgrim_OptLeave</text>
              <results><li><resultName>Leave</resultName></li></results>
            </li>

          </options>
        </value>
      </li>

      <li>
        <key>1</key>
        <value>
          <text>RatkinQL_Pilgrim_Story1</text>
          <extraText><li>RatkinQL_Pilgrim_Story2</li><li>RatkinQL_Pilgrim_Story3</li></extraText>
          <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
          <options>
            <li><text>RatkinQL_Pilgrim_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li>
          </options>
        </value>
      </li>

      <li>
        <key>2</key>
        <value>
          <text>RatkinQL_Pilgrim_Farewell</text>
          <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
          <options>
            <li><text>RatkinQL_Pilgrim_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li>
          </options>
        </value>
      </li>

    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_PilgrimManager</defName>
    <tags><li>RatkinQL_Pilgrim</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_PilgrimTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
