<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    ★商團首領佩林 — 第一章《破爛商團》。
    在講誰的故事：佩林，一個不甘困在農田、跑出來闖蕩的年輕鼠族行商（固定人物，身分由對白承載）。
    玩家聚居點扮演的角色：他行商路上的一處驛站／恩主——你這一章怎麼待他（公道交易／慷慨資助／趁機宰他／打發走），
    會種下他日後結局（見 Ch2/Ch3）的因，並改動你的善惡值與商人名聲（F8 帳本，用 CQFAction_SetGlobalBool 發 RatkinQL_Ev_* 事件旗標）。
    分章閂：genrationConditions 用 Reversal(Bool RatkinQL_Peirin_Met) → 只在「尚未認識佩林」時出現；任一終局選項都設 Peirin_Met 推進到 Ch2。
  -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_PeirinCh1Tree</defName>
    <title>RatkinQL_PeirinCh1Tree_Title</title>
    <dialogReportKey>RatkinQL_PeirinCh1Tree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>

      <li><key>0</key><value>
        <text>RatkinQL_Peirin_Ch1_Greeting</text>
        <index>0</index><subNodeIndexs><li>1</li></subNodeIndexs>
        <options>
          <li>
            <text>RatkinQL_Peirin_Ch1_OptTrade</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <requiredThings>
              <li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>15~15</count></li>
            </requiredThings>
            <results><li>
              <resultName>Trade</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_Spawn">
                  <targetsText><li>Interviewer</li></targetsText>
                  <datas>
                    <li>
                      <dataName>PeirinCurios</dataName>
                      <message>RatkinQL_Peirin_Ch1_MsgTrade</message>
                      <things>
                        <li Class="QuestEditor_Library.CQFThingDefCount"><thing>RK_Food_Hardtack</thing><count>18~18</count></li>
                        <li Class="QuestEditor_Library.CQFThingDefCount"><thing>MedicineHerbal</thing><count>2~2</count></li>
                      </things>
                    </li>
                  </datas>
                </li>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                  <targetsText><li>Interviewee</li></targetsText>
                  <isIncrease>true</isIncrease><value>1</value><sendLetter>false</sendLetter>
                </li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Ev_GenericTrade</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Peirin_Met</keyOfBool><valueOfBool>true</valueOfBool></li>
              </actions>
              <nextIndex>2</nextIndex>
            </li></results>
          </li>

          <li>
            <text>RatkinQL_Peirin_Ch1_OptFund</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <requiredThings>
              <li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>50~50</count></li>
            </requiredThings>
            <results><li>
              <resultName>Fund</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_Message"><message>RatkinQL_Peirin_Ch1_MsgFund</message><type>PositiveEvent</type></li>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                  <targetsText><li>Interviewee</li></targetsText>
                  <isIncrease>true</isIncrease><value>3</value><sendLetter>false</sendLetter>
                </li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Ev_Charity</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Peirin_Met</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Peirin_Funded</keyOfBool><valueOfBool>true</valueOfBool></li>
              </actions>
              <nextIndex>2</nextIndex>
            </li></results>
          </li>

          <li>
            <text>RatkinQL_Peirin_Ch1_OptFleece</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <requiredThings>
              <li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>5~5</count></li>
            </requiredThings>
            <results><li>
              <resultName>Fleece</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_Spawn">
                  <targetsText><li>Interviewer</li></targetsText>
                  <datas>
                    <li>
                      <dataName>PeirinJunk</dataName>
                      <message>RatkinQL_Peirin_Ch1_MsgFleece</message>
                      <things>
                        <li Class="QuestEditor_Library.CQFThingDefCount"><thing>RK_Food_Hardtack</thing><count>20~20</count></li>
                      </things>
                    </li>
                  </datas>
                </li>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                  <targetsText><li>Interviewee</li></targetsText>
                  <isIncrease>false</isIncrease><value>2</value><sendLetter>false</sendLetter>
                </li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Ev_Cruelty</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Peirin_Met</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Peirin_Fleeced</keyOfBool><valueOfBool>true</valueOfBool></li>
              </actions>
              <nextIndex>2</nextIndex>
            </li></results>
          </li>

          <li><text>RatkinQL_Peirin_Ch1_OptStory</text><results><li><resultName>Story</resultName><nextIndex>1</nextIndex></li></results></li>

          <li>
            <text>RatkinQL_Peirin_Ch1_OptLeave</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <results><li>
              <resultName>Leave</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Peirin_Met</keyOfBool><valueOfBool>true</valueOfBool></li>
              </actions>
            </li></results>
          </li>
        </options>
      </value></li>

      <li><key>1</key><value>
        <text>RatkinQL_Peirin_Ch1_Story1</text>
        <extraText><li>RatkinQL_Peirin_Ch1_Story2</li></extraText>
        <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Peirin_Ch1_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>

      <li><key>2</key><value>
        <text>RatkinQL_Peirin_Ch1_Farewell</text>
        <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Peirin_Ch1_OptBye</text><results><li><resultName>Bye</resultName></li></results></li></options>
      </value></li>

    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_PeirinCh1Manager</defName>
    <tags><li>RatkinQL_PeirinCh1</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
      <!-- 分章閂：僅在尚未認識佩林時出現 -->
      <li Class="QuestEditor_Library.DialogCondition_Reversal">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition Class="QuestEditor_Library.DialogCondition_Bool">
          <boolName>RatkinQL_Peirin_Met</boolName>
          <failReason>RatkinQL_NotRatkin</failReason>
        </condition>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_PeirinCh1Tree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
