<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 《收舊貨的》— F1：一名鼠族收荒商，收你的餘料換銀、也兜售些稀奇舊物。市井、詼諧。 -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_JunkTree</defName>
    <title>RatkinQL_JunkTree_Title</title>
    <dialogReportKey>RatkinQL_JunkTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>
      <li><key>0</key><value>
        <text>RatkinQL_Junk_Greeting</text>
        <index>0</index><subNodeIndexs><li>1</li><li>2</li></subNodeIndexs>
        <options>
          <li>
            <text>RatkinQL_Junk_OptSell</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <requiredThings><li Class="QuestEditor_Library.CQFThingDefCount"><thing>WoodLog</thing><count>20~20</count></li></requiredThings>
            <results><li><resultName>Sold</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_Spawn">
                  <targetsText><li>Interviewer</li></targetsText>
                  <datas><li>
                    <dataName>RatkinQL_JunkPay</dataName><chance>1</chance>
                    <message>RatkinQL_Junk_MsgSell</message>
                    <things><li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>15~15</count></li></things>
                  </li></datas>
                </li>
              </actions>
              <nextIndex>2</nextIndex></li></results>
          </li>
          <li><text>RatkinQL_Junk_OptBrowse</text><results><li><resultName>GoBrowse</resultName><nextIndex>1</nextIndex></li></results></li>
          <li><text>RatkinQL_Junk_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li>
        </options>
      </value></li>
      <li><key>1</key><value>
        <text>RatkinQL_Junk_Ware1</text>
        <extraText><li>RatkinQL_Junk_Ware2</li><li>RatkinQL_Junk_Ware3</li></extraText>
        <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Junk_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>
      <li><key>2</key><value>
        <text>RatkinQL_Junk_Farewell</text>
        <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Junk_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li></options>
      </value></li>
    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_JunkManager</defName>
    <tags><li>RatkinQL_Junk</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_JunkTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>
</Defs>
