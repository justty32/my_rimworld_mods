<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    ★鐵匠屋 T2 旗艦《白銀之護·露娜·朱頂紅》對話。信件制、AddDialog 直掛（不需 genrationConditions）。
    T2 訂製：高門檻單件精品（DialogCondition_WeaponValue，minQuality=Excellent、count=1~2、基準＝1 把鋼玉長劍傑出品質），交貨走 C 挑選視窗＋分級後果。
    忠誠獎勵：滿意度達 N（帳本回寫 Forge_KnightCommission_RewardReady）且未領（Reversal RewardClaimed）→ 出現「名譽引薦」選項，發傳家引薦禮、set RewardClaimed＋T3Introduced（她替你向王庭引薦）。
    稱呼＝T2 層「鐵匠鋪」。善惡＝騎士＝正派傾向，只有超額(band2)才記 Ev_Charity（§6.7）。
  -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_ForgeKnightCommissionTree</defName>
    <title>RatkinQL_Forge_Knight_Title</title>
    <dialogReportKey>RatkinQL_Forge_Knight_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>6</curIndex>
    <nodeMoulds>

      <li><key>0</key><value>
        <text>RatkinQL_Forge_Knight_Greeting</text>
        <index>0</index><subNodeIndexs><li>1</li></subNodeIndexs>
        <options>

          <!-- 忠誠獎勵：名譽引薦（RewardReady 且未領才顯示） -->
          <li>
            <text>RatkinQL_Forge_Knight_OptReward</text>
            <hideWhenDisabled>true</hideWhenDisabled>
            <conditions>
              <li Class="QuestEditor_Library.DialogCondition_Bool">
                <failReason>RatkinQL_Forge_Knight_NeedReward</failReason>
                <boolName>RatkinQL_Forge_KnightCommission_RewardReady</boolName>
              </li>
              <li Class="QuestEditor_Library.DialogCondition_Reversal">
                <failReason>RatkinQL_Forge_Knight_NeedReward</failReason>
                <condition Class="QuestEditor_Library.DialogCondition_Bool">
                  <boolName>RatkinQL_Forge_KnightCommission_RewardClaimed</boolName>
                  <failReason>RatkinQL_Forge_Knight_NeedReward</failReason>
                </condition>
              </li>
            </conditions>
            <results><li>
              <resultName>Reward</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_Spawn">
                  <targetsText><li>Interviewer</li></targetsText>
                  <datas>
                    <li>
                      <dataName>KnightIntroduction</dataName>
                      <message>RatkinQL_Forge_Knight_MsgReward</message>
                      <things>
                        <li Class="QuestEditor_Library.CQFThingDefCount"><thing>MechSerumHealer</thing><count>1~1</count></li>
                        <li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>400~400</count></li>
                      </things>
                    </li>
                  </datas>
                </li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Forge_KnightCommission_RewardClaimed</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Forge_T3Introduced</keyOfBool><valueOfBool>true</valueOfBool></li>
              </actions>
              <nextIndex>5</nextIndex>
            </li></results>
          </li>

          <!-- 交貨：傑出以上、1~2 件、總值≥1 把鋼玉傑出長劍 → 開 C 挑選視窗＋分級後果 -->
          <li>
            <text>RatkinQL_Forge_Knight_OptDeliver</text>
            <hideWhenDisabled>true</hideWhenDisabled>
            <removeDialogAfterSelect>false</removeDialogAfterSelect>
            <conditions>
              <li Class="RatkinQuestlines.DialogCondition_WeaponValue">
                <failReason>RatkinQL_Forge_Knight_NeedGoods</failReason>
                <count>1~2</count>
                <minQuality>Excellent</minQuality>
                <refThing>RK_LongSword</refThing>
                <refStuff>Plasteel</refStuff>
                <refQuality>Excellent</refQuality>
                <refCount>1</refCount>
              </li>
            </conditions>
            <results><li>
              <resultName>Deliver</resultName>
              <actions>
                <li Class="RatkinQuestlines.CQFAction_OpenDeliveryWindow">
                  <targetsText><li>Interviewee</li><li>Interviewer</li></targetsText>
                  <count>1~2</count>
                  <minQuality>Excellent</minQuality>
                  <refThing>RK_LongSword</refThing>
                  <refStuff>Plasteel</refStuff>
                  <refQuality>Excellent</refQuality>
                  <refCount>1</refCount>
                  <bands>
                    <!-- band1 達標：一件傑作，500 銀＋滿意度＋軍械商名聲（無 karma） -->
                    <li>
                      <valueMultiple>1</valueMultiple>
                      <silver>500</silver>
                      <evFlags>
                        <li>RatkinQL_Ev_ForgeWellDone_KnightCommission</li>
                        <li>RatkinQL_Ev_WeaponDeal</li>
                      </evFlags>
                      <message>RatkinQL_Forge_Knight_MsgPaid</message>
                    </li>
                    <!-- band2 超額（總值 2×）：更精/更多，900 銀＋更多名聲＋Ev_Charity（為騎士精工超額＝正派善） -->
                    <li>
                      <valueMultiple>2</valueMultiple>
                      <silver>900</silver>
                      <evFlags>
                        <li>RatkinQL_Ev_ForgeWellDone_KnightCommission</li>
                        <li>RatkinQL_Ev_WeaponDeal</li>
                        <li>RatkinQL_Ev_GenericTrade</li>
                        <li>RatkinQL_Ev_Charity</li>
                      </evFlags>
                      <message>RatkinQL_Forge_Knight_MsgPaidFine</message>
                    </li>
                  </bands>
                </li>
              </actions>
            </li></results>
          </li>

          <li>
            <text>RatkinQL_Forge_Knight_OptTerms</text>
            <results><li><resultName>Terms</resultName><nextIndex>1</nextIndex></li></results>
          </li>

          <!-- 抬價敲詐 → blocked＋遣離 -->
          <li>
            <text>RatkinQL_Forge_Knight_OptExtort</text>
            <removeDialogAfterSelect>false</removeDialogAfterSelect>
            <results><li>
              <resultName>Extort</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_Message"><message>RatkinQL_Forge_Knight_MsgExtort</message><type>NegativeEvent</type></li>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                  <targetsText><li>Interviewee</li></targetsText>
                  <isIncrease>false</isIncrease><value>4</value><sendLetter>false</sendLetter>
                </li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Ev_ForgeBlocked_KnightCommission</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="RatkinQuestlines.CQFAction_SendEnvoyAway"><targetsText><li>Interviewee</li></targetsText></li>
              </actions>
              <nextIndex>3</nextIndex>
            </li></results>
          </li>

          <li>
            <text>RatkinQL_Forge_Knight_OptDecline</text>
            <removeDialogAfterSelect>false</removeDialogAfterSelect>
            <results><li><resultName>Decline</resultName></li></results>
          </li>
        </options>
      </value></li>

      <li><key>1</key><value>
        <text>RatkinQL_Forge_Knight_Terms1</text>
        <extraText><li>RatkinQL_Forge_Knight_Terms2</li></extraText>
        <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Forge_Knight_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>

      <li><key>3</key><value>
        <text>RatkinQL_Forge_Knight_ExtortEnd</text>
        <index>3</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Forge_Knight_OptShrug</text><results><li><resultName>Shrug</resultName></li></results></li></options>
      </value></li>

      <!-- 名譽引薦領取後 → 回正題（她仍要她的傑作） -->
      <li><key>5</key><value>
        <text>RatkinQL_Forge_Knight_ThanksReward</text>
        <index>5</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Forge_Knight_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>

    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_ForgeKnightCommissionManager</defName>
    <tags><li>RatkinQL_ForgeKnightCommission</li></tags>
    <genrationConditions />
    <trees><li><tree>RatkinQL_ForgeKnightCommissionTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
