<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    《收路錢的》— F1：一名鼠族攔門索討「過路費」，真假難辨。
    玩家可乖乖付（25 銀）／問憑什麼收（聽他的說辭）／看破騙局（智識>7，識破後回絕，記精明旗標）／直接回絕。
  -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_TollTree</defName>
    <title>RatkinQL_TollTree_Title</title>
    <dialogReportKey>RatkinQL_TollTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>
      <li>
        <key>0</key>
        <value>
          <text>RatkinQL_Toll_Greeting</text>
          <index>0</index>
          <subNodeIndexs><li>1</li><li>2</li></subNodeIndexs>
          <options>
            <li>
              <text>RatkinQL_Toll_OptPay</text>
              <removeDialogAfterSelect>true</removeDialogAfterSelect>
              <requiredThings>
                <li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>25~25</count></li>
              </requiredThings>
              <results>
                <li>
                  <resultName>Paid</resultName>
                  <actions>
                    <li Class="QuestEditor_Library.CQFAction_Message">
                      <message>RatkinQL_Toll_MsgPay</message><type>NeutralEvent</type>
                    </li>
                  </actions>
                  <nextIndex>2</nextIndex>
                </li>
              </results>
            </li>
            <li>
              <text>RatkinQL_Toll_OptWhy</text>
              <results><li><resultName>GoWhy</resultName><nextIndex>1</nextIndex></li></results>
            </li>
            <li>
              <text>RatkinQL_Toll_OptSeeThrough</text>
              <hideWhenDisabled>false</hideWhenDisabled>
              <removeDialogAfterSelect>true</removeDialogAfterSelect>
              <conditions>
                <li Class="QuestEditor_Library.DialogCondition_Skill">
                  <failReason>RatkinQL_Toll_ReasonInt</failReason>
                  <targetText>Interviewer</targetText>
                  <skill>Intellectual</skill>
                  <level>7</level>
                  <needToBeGreater>true</needToBeGreater>
                </li>
              </conditions>
              <results>
                <li>
                  <resultName>SawThrough</resultName>
                  <actions>
                    <li Class="QuestEditor_Library.CQFAction_SetGlobalBool">
                      <keyOfBool>RatkinQL_Rep_Shrewd</keyOfBool><valueOfBool>true</valueOfBool>
                    </li>
                    <li Class="QuestEditor_Library.CQFAction_Message">
                      <message>RatkinQL_Toll_MsgSeeThrough</message><type>PositiveEvent</type>
                    </li>
                  </actions>
                  <nextIndex>2</nextIndex>
                </li>
              </results>
            </li>
            <li>
              <text>RatkinQL_Toll_OptRefuse</text>
              <removeDialogAfterSelect>true</removeDialogAfterSelect>
              <results>
                <li>
                  <resultName>Refused</resultName>
                  <actions>
                    <li Class="QuestEditor_Library.CQFAction_Message">
                      <message>RatkinQL_Toll_MsgRefuse</message><type>NeutralEvent</type>
                    </li>
                  </actions>
                  <nextIndex>2</nextIndex>
                </li>
              </results>
            </li>
          </options>
        </value>
      </li>
      <li>
        <key>1</key>
        <value>
          <text>RatkinQL_Toll_Why1</text>
          <extraText><li>RatkinQL_Toll_Why2</li><li>RatkinQL_Toll_Why3</li></extraText>
          <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
          <options>
            <li><text>RatkinQL_Toll_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li>
          </options>
        </value>
      </li>
      <li>
        <key>2</key>
        <value>
          <text>RatkinQL_Toll_Farewell</text>
          <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
          <options>
            <li><text>RatkinQL_Toll_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li>
          </options>
        </value>
      </li>
    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_TollManager</defName>
    <tags><li>RatkinQL_Toll</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_TollTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
