<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 《節慶的邀請》— F1：鼠族來邀你的聚居地共襄節慶（囤糧節/地底集市/磷光菌信標節）。溫暖、文化味。 -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_FestivalTree</defName>
    <title>RatkinQL_FestivalTree_Title</title>
    <dialogReportKey>RatkinQL_FestivalTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>
      <li><key>0</key><value>
        <text>RatkinQL_Festival_Greeting</text>
        <index>0</index><subNodeIndexs><li>1</li><li>2</li></subNodeIndexs>
        <options>
          <li>
            <text>RatkinQL_Festival_OptGift</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <requiredThings><li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>20~20</count></li></requiredThings>
            <results><li><resultName>Gifted</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction"><targetsText><li>Interviewee</li></targetsText><isIncrease>true</isIncrease><value>2</value><sendLetter>false</sendLetter></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Rep_Kind</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="QuestEditor_Library.CQFAction_Message"><message>RatkinQL_Festival_MsgGift</message><type>PositiveEvent</type></li>
              </actions>
              <nextIndex>2</nextIndex></li></results>
          </li>
          <li><text>RatkinQL_Festival_OptAsk</text><results><li><resultName>GoAsk</resultName><nextIndex>1</nextIndex></li></results></li>
          <li><text>RatkinQL_Festival_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li>
        </options>
      </value></li>
      <li><key>1</key><value>
        <text>RatkinQL_Festival_Fest1</text>
        <extraText><li>RatkinQL_Festival_Fest2</li><li>RatkinQL_Festival_Fest3</li></extraText>
        <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Festival_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>
      <li><key>2</key><value>
        <text>RatkinQL_Festival_Farewell</text>
        <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Festival_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li></options>
      </value></li>
    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_FestivalManager</defName>
    <tags><li>RatkinQL_Festival</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_FestivalTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>
</Defs>
