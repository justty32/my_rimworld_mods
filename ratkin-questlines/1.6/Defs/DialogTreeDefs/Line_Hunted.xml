<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    《被追殺的鼠族》— F6 來襲/防禦 proof-slice。
    挺身迎戰＝CQFAction_Incident 在 Interviewee 所在地圖 fire 原版 RaidEnemy（對話 targets 有 Interviewee 帶 Map，
    純對話即可觸發一場 raid，避開原版 raid 節點的 slate plumbing）。另可問緣由／打發他走（不觸發）。
    迎戰記「傭兵/武力」身份傾向旗標。
  -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_HuntedTree</defName>
    <title>RatkinQL_HuntedTree_Title</title>
    <dialogReportKey>RatkinQL_HuntedTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>
      <li><key>0</key><value>
        <text>RatkinQL_Hunted_Greeting</text>
        <index>0</index><subNodeIndexs><li>1</li><li>2</li></subNodeIndexs>
        <options>

          <!-- 挺身迎戰：fire RaidEnemy 在 Interviewee 地圖 -->
          <li>
            <text>RatkinQL_Hunted_OptFight</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <results><li>
              <resultName>Fight</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                  <targetsText><li>Interviewee</li></targetsText>
                  <isIncrease>true</isIncrease><value>3</value><sendLetter>false</sendLetter>
                </li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool">
                  <keyOfBool>RatkinQL_Ident_Mercenary</keyOfBool><valueOfBool>true</valueOfBool>
                </li>
                <li Class="QuestEditor_Library.CQFAction_Message">
                  <message>RatkinQL_Hunted_MsgFight</message><type>ThreatBig</type>
                </li>
                <li Class="QuestEditor_Library.CQFAction_Incident">
                  <targetsText><li>Interviewee</li></targetsText>
                  <incident>RaidEnemy</incident>
                </li>
              </actions>
              <nextIndex>2</nextIndex>
            </li></results>
          </li>

          <li><text>RatkinQL_Hunted_OptStory</text><results><li><resultName>GoStory</resultName><nextIndex>1</nextIndex></li></results></li>

          <!-- 打發他走：不觸發，追兵隨他而去 -->
          <li>
            <text>RatkinQL_Hunted_OptTurnAway</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <results><li>
              <resultName>TurnAway</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_Message">
                  <message>RatkinQL_Hunted_MsgTurnAway</message><type>NeutralEvent</type>
                </li>
              </actions>
              <nextIndex>2</nextIndex>
            </li></results>
          </li>

        </options>
      </value></li>

      <li><key>1</key><value>
        <text>RatkinQL_Hunted_Story1</text>
        <extraText><li>RatkinQL_Hunted_Story2</li><li>RatkinQL_Hunted_Story3</li></extraText>
        <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Hunted_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>

      <li><key>2</key><value>
        <text>RatkinQL_Hunted_Farewell</text>
        <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Hunted_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li></options>
      </value></li>
    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_HuntedManager</defName>
    <tags><li>RatkinQL_Hunted</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_HuntedTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
