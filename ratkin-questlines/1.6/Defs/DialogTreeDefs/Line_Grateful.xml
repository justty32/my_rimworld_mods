<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    《報恩的過客》— F1：一名鼠族特地登門，為了報答昔日你（或鼠族同胞受你）的恩情，要送你一份謝禮。
    玩家可欣然收下（得禮＋好感）／問是什麼恩情（身世）／婉拒（仍得好感，風度）。文案 Keyed 見 RatkinQL_Grateful.xml。
  -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_GratefulTree</defName>
    <title>RatkinQL_GratefulTree_Title</title>
    <dialogReportKey>RatkinQL_GratefulTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>

      <li>
        <key>0</key>
        <value>
          <text>RatkinQL_Grateful_Greeting</text>
          <index>0</index>
          <subNodeIndexs><li>1</li><li>2</li></subNodeIndexs>
          <options>

            <li>
              <text>RatkinQL_Grateful_OptAccept</text>
              <removeDialogAfterSelect>true</removeDialogAfterSelect>
              <results>
                <li>
                  <resultName>Accept</resultName>
                  <actions>
                    <li Class="QuestEditor_Library.CQFAction_Spawn">
                      <targetsText><li>Interviewer</li></targetsText>
                      <datas>
                        <li>
                          <dataName>RatkinQL_GratefulGift</dataName>
                          <chance>1</chance>
                          <message>RatkinQL_Grateful_MsgAccept</message>
                          <things>
                            <li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>40~40</count></li>
                          </things>
                        </li>
                      </datas>
                    </li>
                    <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                      <targetsText><li>Interviewee</li></targetsText>
                      <isIncrease>true</isIncrease><value>3</value><sendLetter>true</sendLetter>
                    </li>
                    <li Class="QuestEditor_Library.CQFAction_SetGlobalBool">
                      <keyOfBool>RatkinQL_Rep_Kind</keyOfBool><valueOfBool>true</valueOfBool>
                    </li>
                  </actions>
                  <nextIndex>2</nextIndex>
                </li>
              </results>
            </li>

            <li>
              <text>RatkinQL_Grateful_OptStory</text>
              <results><li><resultName>GoStory</resultName><nextIndex>1</nextIndex></li></results>
            </li>

            <li>
              <text>RatkinQL_Grateful_OptDecline</text>
              <removeDialogAfterSelect>true</removeDialogAfterSelect>
              <results>
                <li>
                  <resultName>Decline</resultName>
                  <actions>
                    <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                      <targetsText><li>Interviewee</li></targetsText>
                      <isIncrease>true</isIncrease><value>2</value><sendLetter>true</sendLetter>
                    </li>
                    <li Class="QuestEditor_Library.CQFAction_SetGlobalBool">
                      <keyOfBool>RatkinQL_Rep_Kind</keyOfBool><valueOfBool>true</valueOfBool>
                    </li>
                    <li Class="QuestEditor_Library.CQFAction_Message">
                      <message>RatkinQL_Grateful_MsgDecline</message><type>PositiveEvent</type>
                    </li>
                  </actions>
                  <nextIndex>2</nextIndex>
                </li>
              </results>
            </li>

            <li>
              <text>RatkinQL_Grateful_OptLeave</text>
              <results><li><resultName>Leave</resultName></li></results>
            </li>

          </options>
        </value>
      </li>

      <li>
        <key>1</key>
        <value>
          <text>RatkinQL_Grateful_Story1</text>
          <extraText><li>RatkinQL_Grateful_Story2</li><li>RatkinQL_Grateful_Story3</li></extraText>
          <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
          <options>
            <li><text>RatkinQL_Grateful_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li>
          </options>
        </value>
      </li>

      <li>
        <key>2</key>
        <value>
          <text>RatkinQL_Grateful_Farewell</text>
          <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
          <options>
            <li><text>RatkinQL_Grateful_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li>
          </options>
        </value>
      </li>

    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_GratefulManager</defName>
    <tags><li>RatkinQL_Grateful</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_GratefulTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
