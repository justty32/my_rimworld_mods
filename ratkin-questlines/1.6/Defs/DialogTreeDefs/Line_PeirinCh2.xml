<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    ★商團首領佩林 — 第二章《週轉不靈》。
    佩林再度上門，這回被軍閥的討債隊盯上、週轉又出了問題。玩家聚居點的角色＝他走投無路時的求助對象。
    你的抉擇（借他週轉金／替他擊退追兵［觸發 site 任務 RatkinQL_PeirinAmbush］／趁他急用錢賤價收他全部貨／打發他走）
    分出「幫過他」(Peirin_Helped) 與「他就此潦倒」(Peirin_Broke) 兩條伏線，決定 Ch3 是風光重逢還是破產求收留。
    分章閂：genrationConditions＝已認識(Peirin_Met) 且 尚未結束第二章(Reversal Peirin_Ch2Done)。
  -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_PeirinCh2Tree</defName>
    <title>RatkinQL_PeirinCh2Tree_Title</title>
    <dialogReportKey>RatkinQL_PeirinCh2Tree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>4</curIndex>
    <nodeMoulds>

      <li><key>0</key><value>
        <text>RatkinQL_Peirin_Ch2_Greeting</text>
        <index>0</index><subNodeIndexs><li>1</li></subNodeIndexs>
        <options>
          <li>
            <text>RatkinQL_Peirin_Ch2_OptLend</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <requiredThings>
              <li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>80~80</count></li>
            </requiredThings>
            <results><li>
              <resultName>Lend</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                  <targetsText><li>Interviewee</li></targetsText>
                  <isIncrease>true</isIncrease><value>2</value><sendLetter>false</sendLetter>
                </li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Ev_Charity</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Peirin_Helped</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Peirin_Ch2Done</keyOfBool><valueOfBool>true</valueOfBool></li>
              </actions>
              <nextIndex>2</nextIndex>
            </li></results>
          </li>

          <li>
            <text>RatkinQL_Peirin_Ch2_OptFight</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <results><li>
              <resultName>Fight</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_Quest"><quest>RatkinQL_PeirinAmbush</quest></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Peirin_Helped</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Peirin_Ch2Done</keyOfBool><valueOfBool>true</valueOfBool></li>
              </actions>
              <nextIndex>2</nextIndex>
            </li></results>
          </li>

          <li>
            <text>RatkinQL_Peirin_Ch2_OptExploit</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <requiredThings>
              <li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>10~10</count></li>
            </requiredThings>
            <results><li>
              <resultName>Exploit</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_Spawn">
                  <targetsText><li>Interviewer</li></targetsText>
                  <datas>
                    <li>
                      <dataName>PeirinStock</dataName>
                      <message>RatkinQL_Peirin_Ch2_MsgExploit</message>
                      <things>
                        <li Class="QuestEditor_Library.CQFThingDefCount"><thing>RK_Food_Hardtack</thing><count>30~30</count></li>
                        <li Class="QuestEditor_Library.CQFThingDefCount"><thing>MedicineHerbal</thing><count>4~4</count></li>
                      </things>
                    </li>
                  </datas>
                </li>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                  <targetsText><li>Interviewee</li></targetsText>
                  <isIncrease>false</isIncrease><value>3</value><sendLetter>false</sendLetter>
                </li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Ev_Cruelty</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Peirin_Fleeced</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Peirin_Broke</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Peirin_Ch2Done</keyOfBool><valueOfBool>true</valueOfBool></li>
              </actions>
              <nextIndex>3</nextIndex>
            </li></results>
          </li>

          <li>
            <text>RatkinQL_Peirin_Ch2_OptTurnAway</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <results><li>
              <resultName>TurnAway</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Peirin_Broke</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Peirin_Ch2Done</keyOfBool><valueOfBool>true</valueOfBool></li>
              </actions>
              <nextIndex>3</nextIndex>
            </li></results>
          </li>

          <li><text>RatkinQL_Peirin_Ch2_OptDetail</text><results><li><resultName>Detail</resultName><nextIndex>1</nextIndex></li></results></li>
          <li><text>RatkinQL_Peirin_Ch2_OptLater</text><results><li><resultName>Later</resultName></li></results></li>
        </options>
      </value></li>

      <li><key>1</key><value>
        <text>RatkinQL_Peirin_Ch2_Detail1</text>
        <extraText><li>RatkinQL_Peirin_Ch2_Detail2</li></extraText>
        <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Peirin_Ch2_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>

      <li><key>2</key><value>
        <text>RatkinQL_Peirin_Ch2_FarewellWarm</text>
        <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Peirin_Ch2_OptBye</text><results><li><resultName>Bye</resultName></li></results></li></options>
      </value></li>

      <li><key>3</key><value>
        <text>RatkinQL_Peirin_Ch2_FarewellCold</text>
        <index>3</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Peirin_Ch2_OptBye</text><results><li><resultName>Bye</resultName></li></results></li></options>
      </value></li>

    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_PeirinCh2Manager</defName>
    <tags><li>RatkinQL_PeirinCh2</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
      <li Class="QuestEditor_Library.DialogCondition_Bool">
        <failReason>RatkinQL_NotRatkin</failReason>
        <boolName>RatkinQL_Peirin_Met</boolName>
      </li>
      <li Class="QuestEditor_Library.DialogCondition_Reversal">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition Class="QuestEditor_Library.DialogCondition_Bool">
          <boolName>RatkinQL_Peirin_Ch2Done</boolName>
          <failReason>RatkinQL_NotRatkin</failReason>
        </condition>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_PeirinCh2Tree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
