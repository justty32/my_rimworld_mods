<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    《迷途的信使》— F1 純對話邂逅：一名鼠族信使迷了路來問路。
    玩家可指路（信使回贈打賞＋好感）／聽路上見聞（近況）／送旅途乾糧（好感）。
    結構同 DialogTree_RatkinPeddler（proven）。文案 Keyed 見 Languages/*/Keyed/RatkinQL_Courier.xml。
  -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_CourierTree</defName>
    <title>RatkinQL_CourierTree_Title</title>
    <dialogReportKey>RatkinQL_CourierTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>

      <li>
        <key>0</key>
        <value>
          <text>RatkinQL_Courier_Greeting</text>
          <index>0</index>
          <subNodeIndexs><li>1</li><li>2</li></subNodeIndexs>
          <options>

            <!-- 指路（免費幫忙）→ 信使打賞你 15 銀＋好感＋樂於助人旗標 -->
            <li>
              <text>RatkinQL_Courier_OptDirections</text>
              <removeDialogAfterSelect>true</removeDialogAfterSelect>
              <results>
                <li>
                  <resultName>Directions</resultName>
                  <actions>
                    <li Class="QuestEditor_Library.CQFAction_Spawn">
                      <targetsText><li>Interviewer</li></targetsText>
                      <datas>
                        <li>
                          <dataName>RatkinQL_CourierTip</dataName>
                          <chance>1</chance>
                          <message>RatkinQL_Courier_MsgReward</message>
                          <things>
                            <li Class="QuestEditor_Library.CQFThingDefCount">
                              <thing>Silver</thing>
                              <count>15~15</count>
                            </li>
                          </things>
                        </li>
                      </datas>
                    </li>
                    <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                      <targetsText><li>Interviewee</li></targetsText>
                      <isIncrease>true</isIncrease>
                      <value>2</value>
                      <sendLetter>true</sendLetter>
                    </li>
                    <li Class="QuestEditor_Library.CQFAction_SetGlobalBool">
                      <keyOfBool>RatkinQL_Rep_Helpful</keyOfBool>
                      <valueOfBool>true</valueOfBool>
                    </li>
                  </actions>
                  <nextIndex>2</nextIndex>
                </li>
              </results>
            </li>

            <!-- 聽路上見聞 → 節點 1 -->
            <li>
              <text>RatkinQL_Courier_OptNews</text>
              <results>
                <li><resultName>GoNews</resultName><nextIndex>1</nextIndex></li>
              </results>
            </li>

            <!-- 送旅途乾糧（給 5 硬餅乾）→ 好感＋樂於助人旗標 -->
            <li>
              <text>RatkinQL_Courier_OptFood</text>
              <removeDialogAfterSelect>true</removeDialogAfterSelect>
              <requiredThings>
                <li Class="QuestEditor_Library.CQFThingDefCount">
                  <thing>RK_Food_Hardtack</thing>
                  <count>5~5</count>
                </li>
              </requiredThings>
              <results>
                <li>
                  <resultName>GaveFood</resultName>
                  <actions>
                    <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                      <targetsText><li>Interviewee</li></targetsText>
                      <isIncrease>true</isIncrease>
                      <value>3</value>
                      <sendLetter>true</sendLetter>
                    </li>
                    <li Class="QuestEditor_Library.CQFAction_SetGlobalBool">
                      <keyOfBool>RatkinQL_Rep_Helpful</keyOfBool>
                      <valueOfBool>true</valueOfBool>
                    </li>
                    <li Class="QuestEditor_Library.CQFAction_Message">
                      <message>RatkinQL_Courier_MsgFood</message>
                      <type>PositiveEvent</type>
                    </li>
                  </actions>
                  <nextIndex>2</nextIndex>
                </li>
              </results>
            </li>

            <!-- 告辭 -->
            <li>
              <text>RatkinQL_Courier_OptLeave</text>
              <results><li><resultName>Leave</resultName></li></results>
            </li>

          </options>
        </value>
      </li>

      <li>
        <key>1</key>
        <value>
          <text>RatkinQL_Courier_News1</text>
          <extraText>
            <li>RatkinQL_Courier_News2</li>
            <li>RatkinQL_Courier_News3</li>
          </extraText>
          <index>1</index>
          <parentIndex>0</parentIndex>
          <subNodeIndexs />
          <options>
            <li>
              <text>RatkinQL_Courier_OptBack</text>
              <results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results>
            </li>
          </options>
        </value>
      </li>

      <li>
        <key>2</key>
        <value>
          <text>RatkinQL_Courier_Farewell</text>
          <index>2</index>
          <parentIndex>0</parentIndex>
          <subNodeIndexs />
          <options>
            <li>
              <text>RatkinQL_Courier_OptLeave</text>
              <results><li><resultName>Leave</resultName></li></results>
            </li>
          </options>
        </value>
      </li>

    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_CourierManager</defName>
    <tags><li>RatkinQL_Courier</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
    </genrationConditions>
    <trees>
      <li><tree>RatkinQL_CourierTree</tree><conditions /></li>
    </trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
