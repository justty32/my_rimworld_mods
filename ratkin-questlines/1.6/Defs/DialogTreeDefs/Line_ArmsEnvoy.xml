<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    ★武器商任務線 — 入口《王國信使》。
    在講誰的故事：鼠族王國（Rakinia）這個「派系」——它的軍需與後勤，你成為王室認可的軍械供應者。
    玩家聚居點扮演的角色：軍械工坊／武器商。故此本線用 genrationConditions 篩「聚居點偏武備」
    （RatkinQL_State_Crafter 或 RatkinQL_State_Martial，由 F7 側寫器寫入）——身分＝功能，賣武器的才會被王國找上。
    信使發出採購令：限期打造一批軍械。接下＝設 Arms_Active（開啟交貨對話 Line_ArmsDeliver）。
  -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_ArmsEnvoyTree</defName>
    <title>RatkinQL_ArmsEnvoyTree_Title</title>
    <dialogReportKey>RatkinQL_ArmsEnvoyTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>

      <li><key>0</key><value>
        <text>RatkinQL_Arms_Envoy_Greeting</text>
        <index>0</index><subNodeIndexs><li>1</li></subNodeIndexs>
        <options>
          <li>
            <text>RatkinQL_Arms_Envoy_OptAccept</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <results><li>
              <resultName>Accept</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_Message"><message>RatkinQL_Arms_Envoy_MsgAccept</message><type>PositiveEvent</type></li>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                  <targetsText><li>Interviewee</li></targetsText>
                  <isIncrease>true</isIncrease><value>1</value><sendLetter>false</sendLetter>
                </li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Arms_Active</keyOfBool><valueOfBool>true</valueOfBool></li>
              </actions>
              <nextIndex>2</nextIndex>
            </li></results>
          </li>
          <li><text>RatkinQL_Arms_Envoy_OptTerms</text><results><li><resultName>Terms</resultName><nextIndex>1</nextIndex></li></results></li>
          <li>
            <text>RatkinQL_Arms_Envoy_OptDecline</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <results><li><resultName>Decline</resultName></li></results>
          </li>
        </options>
      </value></li>

      <li><key>1</key><value>
        <text>RatkinQL_Arms_Envoy_Terms1</text>
        <extraText><li>RatkinQL_Arms_Envoy_Terms2</li></extraText>
        <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Arms_Envoy_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>

      <li><key>2</key><value>
        <text>RatkinQL_Arms_Envoy_Sealed</text>
        <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Arms_Envoy_OptBye</text><results><li><resultName>Bye</resultName></li></results></li></options>
      </value></li>

    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_ArmsEnvoyManager</defName>
    <tags><li>RatkinQL_ArmsEnvoy</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
      <!-- 聚居點偏武備（工匠主導 或 武力主導）才會被王國軍需找上 -->
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Bool"><boolName>RatkinQL_State_Crafter</boolName><failReason>RatkinQL_NotRatkin</failReason></li>
          <li Class="QuestEditor_Library.DialogCondition_Bool"><boolName>RatkinQL_State_Martial</boolName><failReason>RatkinQL_NotRatkin</failReason></li>
        </condition>
      </li>
      <!-- 畢業制：軍械商名聲尚未夠高時＝標準訂單（大單線 Line_ArmsEnvoyMajor 用 Rep_WeaponMerchant 開） -->
      <li Class="QuestEditor_Library.DialogCondition_Reversal">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition Class="QuestEditor_Library.DialogCondition_Bool"><boolName>RatkinQL_Rep_WeaponMerchant</boolName><failReason>RatkinQL_NotRatkin</failReason></condition>
      </li>
      <!-- 手上沒有進行中的採購令（可重複：交貨後 Arms_Active 歸 false，信使會再上門） -->
      <li Class="QuestEditor_Library.DialogCondition_Reversal">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition Class="QuestEditor_Library.DialogCondition_Bool"><boolName>RatkinQL_Arms_Active</boolName><failReason>RatkinQL_NotRatkin</failReason></condition>
      </li>
      <li Class="QuestEditor_Library.DialogCondition_Reversal">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition Class="QuestEditor_Library.DialogCondition_Bool"><boolName>RatkinQL_ArmsMajor_Active</boolName><failReason>RatkinQL_NotRatkin</failReason></condition>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_ArmsEnvoyTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
