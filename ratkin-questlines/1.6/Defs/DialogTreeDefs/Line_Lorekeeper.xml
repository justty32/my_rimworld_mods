<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 《講古的老者》— F1：鼠族長者路過，樂於分享鼠族世界的掌故傳說。世界感、傳承味。 -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_LorekeeperTree</defName>
    <title>RatkinQL_LorekeeperTree_Title</title>
    <dialogReportKey>RatkinQL_LorekeeperTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>
      <li><key>0</key><value>
        <text>RatkinQL_Lorekeeper_Greeting</text>
        <index>0</index><subNodeIndexs><li>1</li><li>2</li></subNodeIndexs>
        <options>
          <li><text>RatkinQL_Lorekeeper_OptListen</text><results><li><resultName>GoListen</resultName><nextIndex>1</nextIndex></li></results></li>
          <li>
            <text>RatkinQL_Lorekeeper_OptGift</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <requiredThings><li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>10~10</count></li></requiredThings>
            <results><li><resultName>Gifted</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction"><targetsText><li>Interviewee</li></targetsText><isIncrease>true</isIncrease><value>1</value><sendLetter>false</sendLetter></li>
                <li Class="QuestEditor_Library.CQFAction_Message"><message>RatkinQL_Lorekeeper_MsgGift</message><type>PositiveEvent</type></li>
              </actions>
              <nextIndex>2</nextIndex></li></results>
          </li>
          <li><text>RatkinQL_Lorekeeper_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li>
        </options>
      </value></li>
      <li><key>1</key><value>
        <text>RatkinQL_Lorekeeper_Lore1</text>
        <extraText><li>RatkinQL_Lorekeeper_Lore2</li><li>RatkinQL_Lorekeeper_Lore3</li></extraText>
        <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Lorekeeper_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>
      <li><key>2</key><value>
        <text>RatkinQL_Lorekeeper_Farewell</text>
        <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Lorekeeper_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li></options>
      </value></li>
    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_LorekeeperManager</defName>
    <tags><li>RatkinQL_Lorekeeper</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_LorekeeperTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>
</Defs>
