<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    ★武器商任務線 — 大單交貨《王國軍務特使收貨》。
    大單品質門檻更高：要 5 把「精良（Excellent）以上」長劍（自製 DialogCondition_ThingQuality 閂＋依品質扣料）。
    報酬更厚：白銀 450 ＋ 一紙《王國徵召令狀》。交貨後 ArmsMajor_Active 歸 false（可重複）。
  -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_ArmsDeliverMajorTree</defName>
    <title>RatkinQL_ArmsDeliverMajorTree_Title</title>
    <dialogReportKey>RatkinQL_ArmsDeliverMajorTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>

      <li><key>0</key><value>
        <text>RatkinQL_ArmsMajor_Deliver_Greeting</text>
        <index>0</index><subNodeIndexs />
        <options>
          <li>
            <text>RatkinQL_ArmsMajor_Deliver_OptDeliver</text>
            <hideWhenDisabled>true</hideWhenDisabled>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <conditions>
              <li Class="RatkinQuestlines.DialogCondition_ThingQuality">
                <failReason>RatkinQL_ArmsMajor_NeedQuality</failReason>
                <thing>MeleeWeapon_LongSword</thing>
                <count>5</count>
                <minQuality>Excellent</minQuality>
              </li>
            </conditions>
            <results><li>
              <resultName>Deliver</resultName>
              <actions>
                <li Class="RatkinQuestlines.CQFAction_ConsumeQualityThings">
                  <targetsText><li>Interviewer</li></targetsText>
                  <thing>MeleeWeapon_LongSword</thing>
                  <count>5</count>
                  <minQuality>Excellent</minQuality>
                </li>
                <li Class="QuestEditor_Library.CQFAction_Spawn">
                  <targetsText><li>Interviewer</li></targetsText>
                  <datas>
                    <li>
                      <dataName>ArmsMajorReward</dataName>
                      <message>RatkinQL_ArmsMajor_Deliver_MsgPaid</message>
                      <things>
                        <li Class="QuestEditor_Library.CQFThingDefCount"><thing>RatkinQL_KingdomTally</thing><count>1~1</count></li>
                        <li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>450~450</count></li>
                      </things>
                    </li>
                  </datas>
                </li>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                  <targetsText><li>Interviewee</li></targetsText>
                  <isIncrease>true</isIncrease><value>6</value><sendLetter>false</sendLetter>
                </li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Ev_WeaponDeal</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_ArmsMajor_Active</keyOfBool><valueOfBool>false</valueOfBool></li>
              </actions>
              <nextIndex>2</nextIndex>
            </li></results>
          </li>
          <li><text>RatkinQL_ArmsMajor_Deliver_OptLater</text><results><li><resultName>Later</resultName></li></results></li>
        </options>
      </value></li>

      <li><key>2</key><value>
        <text>RatkinQL_ArmsMajor_Deliver_Thanks</text>
        <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_ArmsMajor_Deliver_OptBye</text><results><li><resultName>Bye</resultName></li></results></li></options>
      </value></li>

    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_ArmsDeliverMajorManager</defName>
    <tags><li>RatkinQL_ArmsDeliverMajor</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
      <li Class="QuestEditor_Library.DialogCondition_Bool">
        <failReason>RatkinQL_NotRatkin</failReason>
        <boolName>RatkinQL_ArmsMajor_Active</boolName>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_ArmsDeliverMajorTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
