<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    《門口的流浪鼠》— F1 純對話邂逅：一名落魄鼠族上門乞討。
    玩家可聽他的身世（近況/世界感）／施捨（20 銀，好感＋慈善旗標）／給幾個銅板（5 銀，慈善旗標）／趕走。
    結構同 proven。文案 Keyed 見 Languages/*/Keyed/RatkinQL_Vagabond.xml。
  -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_VagabondTree</defName>
    <title>RatkinQL_VagabondTree_Title</title>
    <dialogReportKey>RatkinQL_VagabondTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>

      <li>
        <key>0</key>
        <value>
          <text>RatkinQL_Vagabond_Greeting</text>
          <index>0</index>
          <subNodeIndexs><li>1</li><li>2</li></subNodeIndexs>
          <options>

            <!-- 聽他的身世 → 節點 1 -->
            <li>
              <text>RatkinQL_Vagabond_OptStory</text>
              <results>
                <li><resultName>GoStory</resultName><nextIndex>1</nextIndex></li>
              </results>
            </li>

            <!-- 施捨（20 銀）→ 好感＋慈善旗標 -->
            <li>
              <text>RatkinQL_Vagabond_OptAlms</text>
              <removeDialogAfterSelect>true</removeDialogAfterSelect>
              <requiredThings>
                <li Class="QuestEditor_Library.CQFThingDefCount">
                  <thing>Silver</thing>
                  <count>20~20</count>
                </li>
              </requiredThings>
              <results>
                <li>
                  <resultName>GaveAlms</resultName>
                  <actions>
                    <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                      <targetsText><li>Interviewee</li></targetsText>
                      <isIncrease>true</isIncrease>
                      <value>2</value>
                      <sendLetter>true</sendLetter>
                    </li>
                    <li Class="QuestEditor_Library.CQFAction_SetGlobalBool">
                      <keyOfBool>RatkinQL_Rep_Charitable</keyOfBool>
                      <valueOfBool>true</valueOfBool>
                    </li>
                    <li Class="QuestEditor_Library.CQFAction_Message">
                      <message>RatkinQL_Vagabond_MsgAlms</message>
                      <type>PositiveEvent</type>
                    </li>
                  </actions>
                  <nextIndex>2</nextIndex>
                </li>
              </results>
            </li>

            <!-- 給幾個銅板（5 銀）→ 慈善旗標 -->
            <li>
              <text>RatkinQL_Vagabond_OptCoin</text>
              <removeDialogAfterSelect>true</removeDialogAfterSelect>
              <requiredThings>
                <li Class="QuestEditor_Library.CQFThingDefCount">
                  <thing>Silver</thing>
                  <count>5~5</count>
                </li>
              </requiredThings>
              <results>
                <li>
                  <resultName>GaveCoin</resultName>
                  <actions>
                    <li Class="QuestEditor_Library.CQFAction_SetGlobalBool">
                      <keyOfBool>RatkinQL_Rep_Charitable</keyOfBool>
                      <valueOfBool>true</valueOfBool>
                    </li>
                    <li Class="QuestEditor_Library.CQFAction_Message">
                      <message>RatkinQL_Vagabond_MsgCoin</message>
                      <type>NeutralEvent</type>
                    </li>
                  </actions>
                  <nextIndex>2</nextIndex>
                </li>
              </results>
            </li>

            <!-- 趕走 -->
            <li>
              <text>RatkinQL_Vagabond_OptTurnAway</text>
              <results><li><resultName>TurnAway</resultName><nextIndex>2</nextIndex></li></results>
            </li>

          </options>
        </value>
      </li>

      <li>
        <key>1</key>
        <value>
          <text>RatkinQL_Vagabond_Story1</text>
          <extraText>
            <li>RatkinQL_Vagabond_Story2</li>
            <li>RatkinQL_Vagabond_Story3</li>
          </extraText>
          <index>1</index>
          <parentIndex>0</parentIndex>
          <subNodeIndexs />
          <options>
            <li>
              <text>RatkinQL_Vagabond_OptBack</text>
              <results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results>
            </li>
          </options>
        </value>
      </li>

      <li>
        <key>2</key>
        <value>
          <text>RatkinQL_Vagabond_Farewell</text>
          <index>2</index>
          <parentIndex>0</parentIndex>
          <subNodeIndexs />
          <options>
            <li>
              <text>RatkinQL_Vagabond_OptLeave</text>
              <results><li><resultName>Leave</resultName></li></results>
            </li>
          </options>
        </value>
      </li>

    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_VagabondManager</defName>
    <tags><li>RatkinQL_Vagabond</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
    </genrationConditions>
    <trees>
      <li><tree>RatkinQL_VagabondTree</tree><conditions /></li>
    </trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
