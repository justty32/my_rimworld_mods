<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    ★武器商任務線 — 交貨《王國軍需官》。
    信使接下採購令後（Arms_Active），王國派來軍需官到訪收貨。玩家用 requiredThings 交付指定軍械
    （v1：3 把長劍；requiredThings 不足會自動禁用選項＋提示，選後自動扣料——「交貨」原語）。
    交付＝獲得招牌獎勵「王國調兵符」RatkinQL_KingdomTally（使用後召鼠族王國友軍馳援，C# CompUseEffect_RatkinAid）
    ＋一筆白銀 ＋ Ev_WeaponDeal（軍械商名聲＋，F8 帳本）＋ 王國好感。設 Arms_Done 收束本線。
    ⚠ 品質門檻（「特定品質以上」）v1 未實作——requiredThings 只認 ThingDef+數量，不認 quality（見 REVIEW 開放問題）。
  -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_ArmsDeliverTree</defName>
    <title>RatkinQL_ArmsDeliverTree_Title</title>
    <dialogReportKey>RatkinQL_ArmsDeliverTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>

      <li><key>0</key><value>
        <text>RatkinQL_Arms_Deliver_Greeting</text>
        <index>0</index><subNodeIndexs />
        <options>
          <li>
            <text>RatkinQL_Arms_Deliver_OptDeliver</text>
            <hideWhenDisabled>true</hideWhenDisabled>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <!-- ★品質門檻：地圖上要有 >=3 把「優良(Good)以上」長劍才顯示此選項（自製 DialogCondition，requiredThings 認不了品質） -->
            <conditions>
              <li Class="RatkinQuestlines.DialogCondition_ThingQuality">
                <failReason>RatkinQL_Arms_NeedQuality</failReason>
                <thing>MeleeWeapon_LongSword</thing>
                <count>3</count>
                <minQuality>Good</minQuality>
              </li>
            </conditions>
            <results><li>
              <resultName>Deliver</resultName>
              <actions>
                <!-- ★依品質扣料：優先扣達標的（優良以上）長劍，不誤扣爛貨 -->
                <li Class="RatkinQuestlines.CQFAction_ConsumeQualityThings">
                  <targetsText><li>Interviewer</li></targetsText>
                  <thing>MeleeWeapon_LongSword</thing>
                  <count>3</count>
                  <minQuality>Good</minQuality>
                </li>
                <li Class="QuestEditor_Library.CQFAction_Spawn">
                  <targetsText><li>Interviewer</li></targetsText>
                  <datas>
                    <li>
                      <dataName>ArmsReward</dataName>
                      <message>RatkinQL_Arms_Deliver_MsgPaid</message>
                      <things>
                        <li Class="QuestEditor_Library.CQFThingDefCount"><thing>RatkinQL_KingdomTally</thing><count>1~1</count></li>
                        <li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>200~200</count></li>
                      </things>
                    </li>
                  </datas>
                </li>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                  <targetsText><li>Interviewee</li></targetsText>
                  <isIncrease>true</isIncrease><value>4</value><sendLetter>false</sendLetter>
                </li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Ev_WeaponDeal</keyOfBool><valueOfBool>true</valueOfBool></li>
                <!-- 可重複：只把進行中的採購令歸零，不設永久 Done → 信使日後會再上門（名聲夠高則升級成大單） -->
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Arms_Active</keyOfBool><valueOfBool>false</valueOfBool></li>
              </actions>
              <nextIndex>2</nextIndex>
            </li></results>
          </li>
          <li><text>RatkinQL_Arms_Deliver_OptLater</text><results><li><resultName>Later</resultName></li></results></li>
        </options>
      </value></li>

      <li><key>2</key><value>
        <text>RatkinQL_Arms_Deliver_Thanks</text>
        <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Arms_Deliver_OptBye</text><results><li><resultName>Bye</resultName></li></results></li></options>
      </value></li>

    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_ArmsDeliverManager</defName>
    <tags><li>RatkinQL_ArmsDeliver</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
      <li Class="QuestEditor_Library.DialogCondition_Bool">
        <failReason>RatkinQL_NotRatkin</failReason>
        <boolName>RatkinQL_Arms_Active</boolName>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_ArmsDeliverTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
