<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 《報喪的過客》— F1：鼠族捎來遠方同族的死訊/災厄，請你以捐輸致哀。沉重、有份量。 -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_MournerTree</defName>
    <title>RatkinQL_MournerTree_Title</title>
    <dialogReportKey>RatkinQL_MournerTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>
      <li><key>0</key><value>
        <text>RatkinQL_Mourner_Greeting</text>
        <index>0</index><subNodeIndexs><li>1</li><li>2</li></subNodeIndexs>
        <options>
          <li>
            <text>RatkinQL_Mourner_OptDonate</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <requiredThings><li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>20~20</count></li></requiredThings>
            <results><li><resultName>Donated</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction"><targetsText><li>Interviewee</li></targetsText><isIncrease>true</isIncrease><value>2</value><sendLetter>false</sendLetter></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Rep_Kind</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="QuestEditor_Library.CQFAction_Message"><message>RatkinQL_Mourner_MsgDonate</message><type>PositiveEvent</type></li>
              </actions>
              <nextIndex>2</nextIndex></li></results>
          </li>
          <li>
            <text>RatkinQL_Mourner_OptCondolence</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <results><li><resultName>Condoled</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction"><targetsText><li>Interviewee</li></targetsText><isIncrease>true</isIncrease><value>1</value><sendLetter>false</sendLetter></li>
                <li Class="QuestEditor_Library.CQFAction_Message"><message>RatkinQL_Mourner_MsgCondolence</message><type>NeutralEvent</type></li>
              </actions>
              <nextIndex>2</nextIndex></li></results>
          </li>
          <li><text>RatkinQL_Mourner_OptAsk</text><results><li><resultName>GoAsk</resultName><nextIndex>1</nextIndex></li></results></li>
          <li><text>RatkinQL_Mourner_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li>
        </options>
      </value></li>
      <li><key>1</key><value>
        <text>RatkinQL_Mourner_Loss1</text>
        <extraText><li>RatkinQL_Mourner_Loss2</li><li>RatkinQL_Mourner_Loss3</li></extraText>
        <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Mourner_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>
      <li><key>2</key><value>
        <text>RatkinQL_Mourner_Farewell</text>
        <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Mourner_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li></options>
      </value></li>
    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_MournerManager</defName>
    <tags><li>RatkinQL_Mourner</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_MournerTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>
</Defs>
