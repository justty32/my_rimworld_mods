<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    ★武器商任務線 — 大單《王國軍務特使》。
    畢業制：軍械商名聲夠高（F8 帳本 RatkinQL_Rep_WeaponMerchant，weaponMerchant>=25）後，
    王國不再派普通信使發小單，改派**軍務特使**發大單——要更多、品質更高的軍械（5 把精良/Excellent 以上長劍），報酬更厚。
    可重複：交貨後 ArmsMajor_Active 歸 false，特使日後再上門。與標準線互斥（標準線 gate 了 NOT Rep_WeaponMerchant）。
  -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_ArmsEnvoyMajorTree</defName>
    <title>RatkinQL_ArmsEnvoyMajorTree_Title</title>
    <dialogReportKey>RatkinQL_ArmsEnvoyMajorTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>

      <li><key>0</key><value>
        <text>RatkinQL_ArmsMajor_Envoy_Greeting</text>
        <index>0</index><subNodeIndexs><li>1</li></subNodeIndexs>
        <options>
          <li>
            <text>RatkinQL_ArmsMajor_Envoy_OptAccept</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <results><li>
              <resultName>Accept</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_Message"><message>RatkinQL_ArmsMajor_Envoy_MsgAccept</message><type>PositiveEvent</type></li>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                  <targetsText><li>Interviewee</li></targetsText>
                  <isIncrease>true</isIncrease><value>2</value><sendLetter>false</sendLetter>
                </li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_ArmsMajor_Active</keyOfBool><valueOfBool>true</valueOfBool></li>
              </actions>
              <nextIndex>2</nextIndex>
            </li></results>
          </li>
          <li><text>RatkinQL_ArmsMajor_Envoy_OptTerms</text><results><li><resultName>Terms</resultName><nextIndex>1</nextIndex></li></results></li>
          <li>
            <text>RatkinQL_ArmsMajor_Envoy_OptDecline</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <results><li><resultName>Decline</resultName></li></results>
          </li>
        </options>
      </value></li>

      <li><key>1</key><value>
        <text>RatkinQL_ArmsMajor_Envoy_Terms1</text>
        <extraText><li>RatkinQL_ArmsMajor_Envoy_Terms2</li></extraText>
        <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_ArmsMajor_Envoy_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>

      <li><key>2</key><value>
        <text>RatkinQL_ArmsMajor_Envoy_Sealed</text>
        <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_ArmsMajor_Envoy_OptBye</text><results><li><resultName>Bye</resultName></li></results></li></options>
      </value></li>

    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_ArmsEnvoyMajorManager</defName>
    <tags><li>RatkinQL_ArmsEnvoyMajor</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
      <!-- 偏武備 -->
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Bool"><boolName>RatkinQL_State_Crafter</boolName><failReason>RatkinQL_NotRatkin</failReason></li>
          <li Class="QuestEditor_Library.DialogCondition_Bool"><boolName>RatkinQL_State_Martial</boolName><failReason>RatkinQL_NotRatkin</failReason></li>
        </condition>
      </li>
      <!-- 軍械商名聲夠高才解鎖大單 -->
      <li Class="QuestEditor_Library.DialogCondition_Bool">
        <failReason>RatkinQL_NotRatkin</failReason>
        <boolName>RatkinQL_Rep_WeaponMerchant</boolName>
      </li>
      <!-- 手上沒有進行中的採購令（標準或大單） -->
      <li Class="QuestEditor_Library.DialogCondition_Reversal">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition Class="QuestEditor_Library.DialogCondition_Bool"><boolName>RatkinQL_Arms_Active</boolName><failReason>RatkinQL_NotRatkin</failReason></condition>
      </li>
      <li Class="QuestEditor_Library.DialogCondition_Reversal">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition Class="QuestEditor_Library.DialogCondition_Bool"><boolName>RatkinQL_ArmsMajor_Active</boolName><failReason>RatkinQL_NotRatkin</failReason></condition>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_ArmsEnvoyMajorTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
