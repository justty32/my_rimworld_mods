<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 《採藥的郎中》— F1：一名鼠族草藥郎中路過，賣草藥、也給偏方。樸實、有生活智慧。 -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_HealerTree</defName>
    <title>RatkinQL_HealerTree_Title</title>
    <dialogReportKey>RatkinQL_HealerTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>
      <li><key>0</key><value>
        <text>RatkinQL_Healer_Greeting</text>
        <index>0</index><subNodeIndexs><li>1</li><li>2</li></subNodeIndexs>
        <options>
          <li>
            <text>RatkinQL_Healer_OptBuy</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <requiredThings><li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>30~30</count></li></requiredThings>
            <results><li><resultName>Bought</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_Spawn">
                  <targetsText><li>Interviewer</li></targetsText>
                  <datas><li>
                    <dataName>RatkinQL_HealerHerbs</dataName><chance>1</chance>
                    <message>RatkinQL_Healer_MsgBuy</message>
                    <things><li Class="QuestEditor_Library.CQFThingDefCount"><thing>MedicineHerbal</thing><count>5~5</count></li></things>
                  </li></datas>
                </li>
              </actions>
              <nextIndex>2</nextIndex></li></results>
          </li>
          <li><text>RatkinQL_Healer_OptRemedy</text><results><li><resultName>GoRemedy</resultName><nextIndex>1</nextIndex></li></results></li>
          <li><text>RatkinQL_Healer_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li>
        </options>
      </value></li>
      <li><key>1</key><value>
        <text>RatkinQL_Healer_Remedy1</text>
        <extraText><li>RatkinQL_Healer_Remedy2</li><li>RatkinQL_Healer_Remedy3</li></extraText>
        <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Healer_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>
      <li><key>2</key><value>
        <text>RatkinQL_Healer_Farewell</text>
        <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Healer_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li></options>
      </value></li>
    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_HealerManager</defName>
    <tags><li>RatkinQL_Healer</li></tags>
    <genrationConditions>
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_HealerTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>
</Defs>
