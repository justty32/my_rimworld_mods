<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    《鼠信眾紀念碑》觸發對話 — F4 proof-slice 的入口。
    一名鼠族信眾使者上門，委託玩家在殖民地內建一座紀念碑供奉信仰；
    接下委託 → CQFAction_Quest 觸發 RatkinQL_Monument ＋提升鼠族好感
    ＋記「虔誠者」身份傾向旗標（供日後 F7 身份系統讀）。
    removeDialogAfterSelect＝一位使者一份委託，杜絕重複觸發同一任務。
    genrationConditions 照抄 Line_Contract 的鼠族派系篩選。
  -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_MonumentTree</defName>
    <title>RatkinQL_MonumentTree_Title</title>
    <dialogReportKey>RatkinQL_MonumentTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>
      <li><key>0</key><value>
        <text>RatkinQL_Monument_Greeting</text>
        <index>0</index><subNodeIndexs><li>1</li><li>2</li></subNodeIndexs>
        <options>
          <li>
            <text>RatkinQL_Monument_OptAccept</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <results><li>
              <resultName>Accepted</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                  <targetsText><li>Interviewee</li></targetsText>
                  <isIncrease>true</isIncrease><value>2</value><sendLetter>false</sendLetter>
                </li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool">
                  <keyOfBool>RatkinQL_Ident_Faithful</keyOfBool><valueOfBool>true</valueOfBool>
                </li>
                <li Class="QuestEditor_Library.CQFAction_Message">
                  <message>RatkinQL_Monument_MsgAccept</message>
                  <type>PositiveEvent</type>
                </li>
                <li Class="QuestEditor_Library.CQFAction_Quest">
                  <quest>RatkinQL_Monument</quest>
                </li>
              </actions>
              <nextIndex>2</nextIndex>
            </li></results>
          </li>
          <li><text>RatkinQL_Monument_OptTerms</text><results><li><resultName>GoTerms</resultName><nextIndex>1</nextIndex></li></results></li>
          <li><text>RatkinQL_Monument_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li>
        </options>
      </value></li>
      <li><key>1</key><value>
        <text>RatkinQL_Monument_Terms1</text>
        <extraText><li>RatkinQL_Monument_Terms2</li><li>RatkinQL_Monument_Terms3</li></extraText>
        <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Monument_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>
      <li><key>2</key><value>
        <text>RatkinQL_Monument_Farewell</text>
        <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Monument_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li></options>
      </value></li>
    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_MonumentManager</defName>
    <tags><li>RatkinQL_Monument</li></tags>
    <genrationConditions>
      <!-- 限鼠族派系（照抄 Line_Contract） -->
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_MonumentTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
