<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    《軍閥據點懸賞》觸發對話 — F5 site 攻打任務的入口。
    鼠族傭兵掮客上門懸賞：接下→CQFAction_Quest 觸發 RatkinQL_RaidOutpost（world map site，見
    QuestScript_RaidOutpost.xml）＋提升鼠族好感＋記「傭兵」身份傾向旗標（供日後 F7 身份系統讀）。
    removeDialogAfterSelect＝一位掮客一份懸賞，杜絕重複接單刷賞金。
    結構照我方既有 Line_*.xml（3 節點：問候/詳情/告別，仿 Line_Contract）。
  -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_RaidOutpostTree</defName>
    <title>RatkinQL_RaidOutpostTree_Title</title>
    <dialogReportKey>RatkinQL_RaidOutpostTree_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>3</curIndex>
    <nodeMoulds>
      <li><key>0</key><value>
        <text>RatkinQL_RaidOutpost_Greeting</text>
        <index>0</index><subNodeIndexs><li>1</li><li>2</li></subNodeIndexs>
        <options>
          <li>
            <text>RatkinQL_RaidOutpost_OptAccept</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <results><li>
              <resultName>Accepted</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_Quest">
                  <quest>RatkinQL_RaidOutpost</quest>
                </li>
                <li Class="QuestEditor_Library.CQFAction_ChangeGoodwillOfFaction">
                  <targetsText><li>Interviewee</li></targetsText>
                  <isIncrease>true</isIncrease><value>2</value><sendLetter>false</sendLetter>
                </li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool">
                  <keyOfBool>RatkinQL_Ident_Mercenary</keyOfBool><valueOfBool>true</valueOfBool>
                </li>
                <li Class="QuestEditor_Library.CQFAction_Message">
                  <message>RatkinQL_RaidOutpost_MsgAccept</message>
                  <type>PositiveEvent</type>
                </li>
              </actions>
              <nextIndex>2</nextIndex>
            </li></results>
          </li>
          <li><text>RatkinQL_RaidOutpost_OptDetails</text><results><li><resultName>GoDetails</resultName><nextIndex>1</nextIndex></li></results></li>
          <li><text>RatkinQL_RaidOutpost_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li>
        </options>
      </value></li>
      <li><key>1</key><value>
        <text>RatkinQL_RaidOutpost_Details1</text>
        <extraText><li>RatkinQL_RaidOutpost_Details2</li><li>RatkinQL_RaidOutpost_Details3</li></extraText>
        <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_RaidOutpost_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>
      <li><key>2</key><value>
        <text>RatkinQL_RaidOutpost_Farewell</text>
        <index>2</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_RaidOutpost_OptLeave</text><results><li><resultName>Leave</resultName></li></results></li></options>
      </value></li>
    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_RaidOutpostManager</defName>
    <tags><li>RatkinQL_RaidOutpost</li></tags>
    <genrationConditions>
      <!-- 限鼠族派系（照抄 Line_Contract 的鼠族派系篩選） -->
      <li Class="QuestEditor_Library.DialogCondition_Or">
        <failReason>RatkinQL_NotRatkin</failReason>
        <condition>
          <li Class="QuestEditor_Library.DialogCondition_Faction"><targetText>Interviewee</targetText><faction>Rakinia</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="RKU.RatkinUnderground"><targetText>Interviewee</targetText><faction>RKU_Faction</faction></li>
          <li Class="QuestEditor_Library.DialogCondition_Faction" MayRequire="W.ZHP"><targetText>Interviewee</targetText><faction>ZHP_Faction</faction></li>
        </condition>
      </li>
    </genrationConditions>
    <trees><li><tree>RatkinQL_RaidOutpostTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
