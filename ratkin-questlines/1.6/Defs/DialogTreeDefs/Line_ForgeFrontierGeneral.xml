<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    ★鐵匠屋 T3 選配《日食·探尋者·邊疆守將》對話。信件制、AddDialog 直掛。
    傳奇單件：頂級門檻（DialogCondition_WeaponValue，minQuality=Excellent、count=1~2、基準＝一把鋼玉傑出長劍），交貨走 C 挑選視窗＋分級後果。
    忠誠獎勵：滿意度達 N（帳本回寫 Forge_FrontierGeneral_RewardReady）且未領（Reversal RewardClaimed）→ 出現「傳家厚賞」選項，發傳家名器＋頂級厚賞、set RewardClaimed。
    ★她是遊俠武將、不代表王庭：敲詐＝blocked＋遣離，不動派系好感。
    稱呼＝T3「名匠鋪」。善惡＝正派名將，只有超額(band2)才記 Ev_Charity（§6.7）。
    聲線＝遊俠武將的孤高簡練＋對好兵器的惺惺相惜（別跟映山紅王庭公文腔雷同）。
  -->
  <QuestEditor_Library.DialogTreeDef>
    <defName>RatkinQL_ForgeFrontierGeneralTree</defName>
    <title>RatkinQL_Forge_Frontier_Title</title>
    <dialogReportKey>RatkinQL_Forge_Frontier_Report</dialogReportKey>
    <requireNonHostile>true</requireNonHostile>
    <curIndex>6</curIndex>
    <nodeMoulds>

      <li><key>0</key><value>
        <text>RatkinQL_Forge_Frontier_Greeting</text>
        <index>0</index><subNodeIndexs><li>1</li></subNodeIndexs>
        <options>

          <!-- 忠誠獎勵：傳家厚賞（RewardReady 且未領才顯示） -->
          <li>
            <text>RatkinQL_Forge_Frontier_OptReward</text>
            <hideWhenDisabled>true</hideWhenDisabled>
            <conditions>
              <li Class="QuestEditor_Library.DialogCondition_Bool">
                <failReason>RatkinQL_Forge_Frontier_NeedReward</failReason>
                <boolName>RatkinQL_Forge_FrontierGeneral_RewardReady</boolName>
              </li>
              <li Class="QuestEditor_Library.DialogCondition_Reversal">
                <failReason>RatkinQL_Forge_Frontier_NeedReward</failReason>
                <condition Class="QuestEditor_Library.DialogCondition_Bool">
                  <boolName>RatkinQL_Forge_FrontierGeneral_RewardClaimed</boolName>
                  <failReason>RatkinQL_Forge_Frontier_NeedReward</failReason>
                </condition>
              </li>
            </conditions>
            <results><li>
              <resultName>Reward</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_Spawn">
                  <targetsText><li>Interviewer</li></targetsText>
                  <datas>
                    <li>
                      <dataName>FrontierBounty</dataName>
                      <message>RatkinQL_Forge_Frontier_MsgReward</message>
                      <things>
                        <li Class="QuestEditor_Library.CQFThingDefCount"><thing>MechSerumHealer</thing><count>1~1</count></li>
                        <li Class="QuestEditor_Library.CQFThingDefCount"><thing>Gold</thing><count>120~120</count></li>
                        <li Class="QuestEditor_Library.CQFThingDefCount"><thing>Silver</thing><count>500~500</count></li>
                      </things>
                    </li>
                  </datas>
                </li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Forge_FrontierGeneral_RewardClaimed</keyOfBool><valueOfBool>true</valueOfBool></li>
              </actions>
              <nextIndex>5</nextIndex>
            </li></results>
          </li>

          <!-- 交貨：傑出以上、1~2 件、總值≥一把鋼玉傑出長劍 → 開 C 挑選視窗＋分級後果 -->
          <li>
            <text>RatkinQL_Forge_Frontier_OptDeliver</text>
            <hideWhenDisabled>true</hideWhenDisabled>
            <removeDialogAfterSelect>false</removeDialogAfterSelect>
            <conditions>
              <li Class="RatkinQuestlines.DialogCondition_WeaponValue">
                <failReason>RatkinQL_Forge_Frontier_NeedGoods</failReason>
                <count>1~2</count>
                <minQuality>Excellent</minQuality>
                <refThing>RK_LongSword</refThing>
                <refStuff>Plasteel</refStuff>
                <refQuality>Excellent</refQuality>
                <refCount>1</refCount>
              </li>
            </conditions>
            <results><li>
              <resultName>Deliver</resultName>
              <actions>
                <li Class="RatkinQuestlines.CQFAction_OpenDeliveryWindow">
                  <targetsText><li>Interviewee</li><li>Interviewer</li></targetsText>
                  <count>1~2</count>
                  <minQuality>Excellent</minQuality>
                  <refThing>RK_LongSword</refThing>
                  <refStuff>Plasteel</refStuff>
                  <refQuality>Excellent</refQuality>
                  <refCount>1</refCount>
                  <!-- §6.9：命名入冊時記在名冊上的客戶（是誰把這把兵器帶走的） -->
                  <legendaryClient>FrontierGeneral</legendaryClient>
                  <bands>
                    <!-- band1 達標：一件卓越，700 銀＋滿意度＋軍械商名聲（無 karma） -->
                    <li>
                      <valueMultiple>1</valueMultiple>
                      <silver>700</silver>
                      <evFlags>
                        <li>RatkinQL_Ev_ForgeWellDone_FrontierGeneral</li>
                        <li>RatkinQL_Ev_WeaponDeal</li>
                      </evFlags>
                      <message>RatkinQL_Forge_Frontier_MsgPaid</message>
                    </li>
                    <!-- band2 超額（總值 2×，更精/更多）：1200 銀＋更多名聲＋Ev_Charity（為名將精工超額＝正派善）
                         ★§6.9 名匠傳奇武器的觸發點＝本包唯一的頂 band 命名：交出去的最值錢那把會被日食當場命名、
                         入傳奇名冊，之後由 QuestScript_LegendaryWeaponTale 隨機帶回它的傳聞。
                         （只掛在這裡是照 6b §6.9「名匠＝T3/頂層、最高次高品質＋總值很高」的定案；
                          映山紅是量大薄利的 8~12 件大單，替其中一把命名不合這條線的味道。） -->
                    <li>
                      <valueMultiple>2</valueMultiple>
                      <silver>1200</silver>
                      <evFlags>
                        <li>RatkinQL_Ev_ForgeWellDone_FrontierGeneral</li>
                        <li>RatkinQL_Ev_WeaponDeal</li>
                        <li>RatkinQL_Ev_GenericTrade</li>
                        <li>RatkinQL_Ev_Charity</li>
                      </evFlags>
                      <message>RatkinQL_Forge_Frontier_MsgPaidFine</message>
                      <nameLegendary>true</nameLegendary>
                    </li>
                  </bands>
                </li>
              </actions>
            </li></results>
          </li>

          <li>
            <text>RatkinQL_Forge_Frontier_OptTerms</text>
            <results><li><resultName>Terms</resultName><nextIndex>1</nextIndex></li></results>
          </li>

          <!-- 趁她看重此劍臨時抬價敲詐 → blocked＋遣離（她是遊俠，不動派系好感） -->
          <li>
            <text>RatkinQL_Forge_Frontier_OptExtort</text>
            <removeDialogAfterSelect>true</removeDialogAfterSelect>
            <results><li>
              <resultName>Extort</resultName>
              <actions>
                <li Class="QuestEditor_Library.CQFAction_Message"><message>RatkinQL_Forge_Frontier_MsgExtort</message><type>NegativeEvent</type></li>
                <li Class="QuestEditor_Library.CQFAction_SetGlobalBool"><keyOfBool>RatkinQL_Ev_ForgeBlocked_FrontierGeneral</keyOfBool><valueOfBool>true</valueOfBool></li>
                <li Class="RatkinQuestlines.CQFAction_SendEnvoyAway"><targetsText><li>Interviewee</li></targetsText></li>
              </actions>
              <nextIndex>3</nextIndex>
            </li></results>
          </li>

          <li>
            <text>RatkinQL_Forge_Frontier_OptDecline</text>
            <removeDialogAfterSelect>false</removeDialogAfterSelect>
            <results><li><resultName>Decline</resultName></li></results>
          </li>
        </options>
      </value></li>

      <li><key>1</key><value>
        <text>RatkinQL_Forge_Frontier_Terms1</text>
        <extraText><li>RatkinQL_Forge_Frontier_Terms2</li></extraText>
        <index>1</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Forge_Frontier_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>

      <li><key>3</key><value>
        <text>RatkinQL_Forge_Frontier_ExtortEnd</text>
        <index>3</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Forge_Frontier_OptShrug</text><results><li><resultName>Shrug</resultName></li></results></li></options>
      </value></li>

      <!-- 傳家厚賞領取後 → 回正題（她仍要她的傳世名器） -->
      <li><key>5</key><value>
        <text>RatkinQL_Forge_Frontier_ThanksReward</text>
        <index>5</index><parentIndex>0</parentIndex><subNodeIndexs />
        <options><li><text>RatkinQL_Forge_Frontier_OptBack</text><results><li><resultName>Back</resultName><nextIndex>0</nextIndex></li></results></li></options>
      </value></li>

    </nodeMoulds>
  </QuestEditor_Library.DialogTreeDef>

  <QuestEditor_Library.DialogManagerDef>
    <defName>RatkinQL_ForgeFrontierGeneralManager</defName>
    <tags><li>RatkinQL_ForgeFrontierGeneral</li></tags>
    <genrationConditions />
    <trees><li><tree>RatkinQL_ForgeFrontierGeneralTree</tree><conditions /></li></trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
