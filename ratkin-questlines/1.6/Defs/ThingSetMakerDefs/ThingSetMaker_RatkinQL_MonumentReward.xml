<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- F4《紀念碑》守護期滿的謝禮。沿用 ThingSetMaker_RatkinQL.xml（F2 供貨約）同款
       ThingSetMaker_Sum + StackCount 寫法，獨立成檔以免動到既有檔案。 -->
  <ThingSetMakerDef>
    <defName>RatkinQL_MonumentReward</defName>
    <root Class="ThingSetMaker_Sum">
      <options>
        <li>
          <thingSetMaker Class="ThingSetMaker_StackCount">
            <fixedParams>
              <filter>
                <thingDefs>
                  <li>Silver</li>
                </thingDefs>
              </filter>
              <countRange>200~350</countRange>
            </fixedParams>
          </thingSetMaker>
        </li>
      </options>
    </root>
  </ThingSetMakerDef>

</Defs>
