<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       具名特殊角色本體：燼歌者・薇絲珀（Vesper, the Ash Singer）
       範式來源：官方教學範例 SCMF Sample
         3668177055/1.6/Mods/Ancot.MiliraRace/Defs/PawnkindDef/PawnKinds_Milira_Sample.xml
       差異：本例用原版人類（ParentName=VillagerBase，
         Data/Core/Defs/PawnKindDefs_Humanlikes/PawnKinds_Outlander.xml:16），
       不需任何種族 mod。
       框架「必填三件套」＝ FixedIdentityExtension + NPCKindTag + SpecialPawnExtension
       （範例原話：The classes upon must be included，PawnKinds_Milira_Sample.xml:250-251）。
       ============================================================ -->
  <PawnKindDef ParentName="VillagerBase">
    <defName>PAS_AEC_AshSinger</defName>
    <label>ash singer</label>
    <combatPower>120</combatPower>
    <isFighter>true</isFighter>

    <!-- 只允許本 mod 的專屬背景 tag，杜絕隨機背景 -->
    <backstoryFiltersOverride>
      <li>
        <categories>
          <li>PAS_AEC_AshSinger</li>
        </categories>
      </li>
    </backstoryFiltersOverride>

    <!-- 固定髮色（範式：PawnKinds_Milira_Sample.xml:113） -->
    <forcedHairColor>(230,230,235)</forcedHairColor>

    <!-- 技能授予：vanilla PawnKindDef.abilities，生成即持有。
         下游實例：Cangyan PawnKinds_Milira_Cangyan.xml:72-75。 -->
    <abilities>
      <li>PAS_AEC_AshenWarcry</li>
    </abilities>

    <modExtensions>

      <!-- 必填 1/3：固定身分（欄位總表 decompiled.cs:16210-16243）。
           注意 forceMale 預設為 true，女性角色必須明寫 genderMode。 -->
      <li Class="AriandelLibrary.FixedIdentityExtension">
        <firstNameKey>PAS_AEC_Name_First</firstNameKey>
        <lastNameKey>PAS_AEC_Name_Last</lastNameKey>
        <nickNameKey>PAS_AEC_Name_Nick</nickNameKey>
        <genderMode>Female</genderMode>
        <forcedAgeYears>34</forcedAgeYears>
        <forcedChronologicalAgeYears>34</forcedChronologicalAgeYears>
        <childhoodBackstoryDef>PAS_AEC_Childhood_AshOrphan</childhoodBackstoryDef>
        <adulthoodBackstoryDef>PAS_AEC_Adulthood_AshSinger</adulthoodBackstoryDef>
        <disableRandomTraits>true</disableRandomTraits>
        <extraForcedTraits>
          <li>
            <def>PAS_AEC_AshSoul</def>
          </li>
          <li>
            <def>Tough</def>
          </li>
        </extraForcedTraits>
        <extraForcedHediffs>
          <li>
            <def>PAS_AEC_EmberHeart</def>
            <severity>1</severity>
            <overwriteIfExists>true</overwriteIfExists>
          </li>
        </extraForcedHediffs>
      </li>

      <!-- 必填 2/3：角色標籤（供面部動畫橋接等系統回指，decompiled.cs:13990） -->
      <li Class="AriandelLibrary.NPCKindTag">
        <npcTag>PAS_AshSinger</npcTag>
      </li>

      <!-- 必填 3/3：登錄進特殊角色管理器（SCM）。
           uniqueID 是全域唯一主鍵（staticID），絕不可與其他 mod 重複
           （PawnKinds_Milira_Sample.xml:202-204 原註解）。
           頭像規格：256x256 或 128x128 png（PawnKinds_Milira_Sample.xml:210-211）。 -->
      <li Class="AriandelLibrary.SpecialPawnExtension">
        <uniqueID>PAS_AshSinger</uniqueID>
        <tabDef>PAS_AEC_Tab</tabDef>
        <iconPathRecruited>PAS_AEC/Icon/AshSinger</iconPathRecruited>
        <iconBGPath>AriandelLibrary/Icon/BGTex/BGShroud</iconBGPath>
        <labelKey>PAS_AEC_SpecialPawn.label</labelKey>
        <descKey>PAS_AEC_SpecialPawn.desc</descKey>
        <normalCooldownTicks>300000</normalCooldownTicks>
        <resurrectCooldownTicks>2700000</resurrectCooldownTicks>
        <order>1</order>
      </li>

      <!-- 以下為選用的「Boss／具名角色直覺」保護開關 -->

      <!-- 不會真死：死亡改為送回虛境進復活冷卻
           （Pawn.Kill 前綴攔截，decompiled.cs:16657/16677） -->
      <li Class="AriandelLibrary.AL_Kill_Manager_Extension" />

      <!-- 禁精神崩潰 -->
      <li Class="AriandelLibrary.AL_RefuseMentalBreak_Extension">
        <blockMentalBreak>true</blockMentalBreak>
      </li>

      <!-- 禁救援／俘虜／拘捕右鍵（角色屬敵對或中立時防呆） -->
      <li Class="AriandelLibrary.AL_FloatMenuBlocker_Extension">
        <blockRescue>true</blockRescue>
        <blockCapture>true</blockCapture>
        <blockArrest>true</blockArrest>
      </li>

      <!-- 年齡凍結：具名角色不老 -->
      <li Class="AriandelLibrary.AL_AgeFreeze_Extension">
        <freezeBiologicalAge>true</freezeBiologicalAge>
      </li>

      <!-- 專屬特質鎖：其他 pawn 帶到此特質會被自動移除 -->
      <li Class="AriandelLibrary.AL_TraitLock_Extension">
        <requiredTraits>
          <li>PAS_AEC_AshSoul</li>
        </requiredTraits>
      </li>

      <!-- 防止生出「小薇絲珀」複製人：後代 kind 替換為普通村民 -->
      <li Class="AriandelLibrary.AL_AzzyPregnancy_Extension">
        <replaceWithKind>Villager</replaceWithKind>
      </li>

      <!-- DLC gated 工具示範：無 Anomaly 時整行被 XML 載入器忽略 -->
      <li Class="AriandelLibrary.Anomaly.AL_ObeliskDuplicationBlocker_Extension"
          MayRequire="Ludeon.RimWorld.Anomaly" />

    </modExtensions>
  </PawnKindDef>

</Defs>
