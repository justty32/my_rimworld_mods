<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    對話掛載器：把 CQFExample_GuideTree 綁上 pawn。
    DialogManagerDef :22279  trees(List<DialogTreeAndConditions>)/tags/genrationConditions/
                             forcedTraits/removeWhenThingDespawned(預設true)/removeWhenPawnDied(預設true)
    DialogTreeAndConditions :22432  tree(DialogTreeDef defName 交叉引用) + conditions
    GetTree :22366  取第一棵條件全滿足的樹（conditions 空＝無條件）
    tags 供 SpecialPawnGenerator_AddDialog（:20244，按 tag 撿）與
         CQFAction_AddRandomDialogManager（:2232）索引。
  -->
  <QuestEditor_Library.DialogManagerDef>
    <defName>CQFExample_GuideManager</defName>
    <tags>
      <li>CQFExample_Guide</li>
    </tags>
    <trees>
      <li>
        <tree>CQFExample_GuideTree</tree>
        <conditions />
      </li>
    </trees>
  </QuestEditor_Library.DialogManagerDef>

</Defs>
