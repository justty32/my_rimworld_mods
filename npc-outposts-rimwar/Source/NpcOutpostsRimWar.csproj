<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    建置：dotnet build Source/NpcOutpostsRimWar.csproj -c Release
    參考組件路徑可由 /p: 覆寫（預設＝本機 Linux Steam 安裝，已驗證存在）：
      RimWarDll        Rim War 主程式（workshop 2222935097，注意資料夾是 v1.6）
      HarmonyDll       0Harmony.dll（workshop 2009463077）
      NpcOutpostsDll   姊妹 mod npc-outposts 的建置產物（同倉庫）
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>NpcOutpostsRimWar</AssemblyName>
    <RootNamespace>pas.outposts.rimwar</RootNamespace>
    <OutputPath>..\1.6\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <RimWarDll Condition=" '$(RimWarDll)' == '' ">$(HOME)/.local/share/Steam/steamapps/workshop/content/294100/2222935097/v1.6/Assemblies/RimWar.dll</RimWarDll>
    <HarmonyDll Condition=" '$(HarmonyDll)' == '' ">$(HOME)/.local/share/Steam/steamapps/workshop/content/294100/2009463077/Current/Assemblies/0Harmony.dll</HarmonyDll>
    <NpcOutpostsDll Condition=" '$(NpcOutpostsDll)' == '' ">..\..\npc-outposts\1.6\Assemblies\NpcOutposts.dll</NpcOutpostsDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <Reference Include="RimWar">
      <HintPath>$(RimWarDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NpcOutposts">
      <HintPath>$(NpcOutpostsDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
