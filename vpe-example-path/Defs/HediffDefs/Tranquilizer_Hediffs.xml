<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 鎮靜：意識/移動下壓的 debuff。
       時限機制：AbilityDef 的 durationTime 會寫進 HediffComp_Disappears.ticksToDisappear
       (VEF.cs:68628-68655)，所以本 hediff 必須帶 HediffCompProperties_Disappears。 -->
  <HediffDef>
    <defName>PASVPE_Sedation</defName>
    <label>psychic sedation</label>
    <description>A psycaster has flooded this creature's mind with numbing calm. Consciousness and movement are dulled until the effect wears off.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.75, 0.95)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>7500</disappearsAfterTicks> <!-- 會被 durationTime 覆寫 -->
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.35</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.25</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- 心靈壁壘：施法者自體 buff（AbilityExtension_Hediff.applyToCaster=true 上到自己）。 -->
  <HediffDef>
    <defName>PASVPE_MindBarrier</defName>
    <label>mind barrier</label>
    <description>This psycaster's mind is hardened into a psychic barrier, deflecting part of incoming harm and dampening psychic intrusion.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.9, 0.7)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>15000</disappearsAfterTicks> <!-- 會被 durationTime 覆寫 -->
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
          <PainShockThreshold>0.15</PainShockThreshold>
        </statOffsets>
        <statFactors>
          <PsychicSensitivity>0.5</PsychicSensitivity>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
